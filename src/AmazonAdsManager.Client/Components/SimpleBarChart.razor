@namespace AmazonAdsManager.Client.Components
@using System.Globalization

<div class="simple-chart">
    <div class="simple-chart__header">
        <div>
            <strong>@Title</strong>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <div class="simple-chart__subtitle">@Subtitle</div>
            }
        </div>
        @if (MaxValue > 0)
        {
            <span class="simple-chart__max">@EffectiveMaxLabel: @FormatValue(MaxValue)</span>
        }
    </div>

    @if (!DisplayPoints.Any())
    {
        <div class="text-muted small py-3">No chart data yet.</div>
    }
    else if (UseHorizontal)
    {
        <div class="simple-chart__axis-summary">
            <span>X: @EffectiveYAxisLabel</span>
            <span>Y: @EffectiveXAxisLabel</span>
        </div>
        <div class="simple-chart__horizontal" role="img" aria-label="@Title">
            @foreach (var point in DisplayPoints)
            {
                <div class="simple-chart__hrow">
                    <div class="simple-chart__hlabel" title="@point.Label">@ShortLabel(point.Label, 28)</div>
                    <div class="simple-chart__htrack">
                        <div class="simple-chart__hbar" style="@BarWidthStyle(point.Value)" title="@($"{point.Label}: {FormatValue(point.Value)}")"></div>
                    </div>
                    <div class="simple-chart__hvalue">@FormatValue(point.Value)</div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="simple-chart__axis-summary">
            <span>X: @EffectiveXAxisLabel</span>
            <span>Y: @EffectiveYAxisLabel</span>
        </div>
        <div class="simple-chart__vertical" role="img" aria-label="@Title">
            <div class="simple-chart__ylabel">@EffectiveYAxisLabel</div>
            <div class="simple-chart__yaxis">
                <span>@FormatValue(MaxValue)</span>
                <span>@FormatValue(MaxValue / 2m)</span>
                <span>0</span>
            </div>
            <div class="simple-chart__plot">
                <div class="simple-chart__bars">
                    @{
                        var index = 0;
                    }
                    @foreach (var point in DisplayPoints)
                    {
                        <div class="simple-chart__slot">
                            <div class="simple-chart__bar" style="@BarHeightStyle(point.Value)" title="@($"{point.Label}: {FormatValue(point.Value)}")"></div>
                        </div>
                        index++;
                    }
                </div>
                <div class="simple-chart__xlabels">
                    @{
                        index = 0;
                    }
                    @foreach (var point in DisplayPoints)
                    {
                        <span title="@point.Label">@(index % XLabelStep == 0 || index == DisplayPoints.Count - 1 ? ShortLabel(point.Label, 5) : "")</span>
                        index++;
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(XAxisLabel))
                {
                    <div class="simple-chart__xlabel">@EffectiveXAxisLabel</div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public string Unit { get; set; } = "";
    [Parameter] public string ValuePrefix { get; set; } = "";
    [Parameter] public string ValueSuffix { get; set; } = "";
    [Parameter] public string Color { get; set; } = "#ff5a00";
    [Parameter] public string XAxisLabel { get; set; } = "";
    [Parameter] public string YAxisLabel { get; set; } = "";
    [Parameter] public string MaxLabel { get; set; } = "";
    [Parameter] public bool Horizontal { get; set; }
    [Parameter] public IReadOnlyList<ChartPointDto> Points { get; set; } = Array.Empty<ChartPointDto>();

    private List<ChartPointDto> DisplayPoints => Points
        .Where(p => !string.IsNullOrWhiteSpace(p.Label))
        .Take(32)
        .ToList();

    private bool UseHorizontal => Horizontal || (DisplayPoints.Any(p => p.Label.Length > 8) && DisplayPoints.Count <= 10);
    private decimal MaxValue => DisplayPoints.Any() ? Math.Max(1m, DisplayPoints.Max(p => Math.Abs(p.Value))) : 0m;
    private int XLabelStep => DisplayPoints.Count <= 12 ? 1 : DisplayPoints.Count <= 24 ? 3 : 4;
    private string EffectiveXAxisLabel => string.IsNullOrWhiteSpace(XAxisLabel) ? "Category" : XAxisLabel;
    private string EffectiveYAxisLabel => string.IsNullOrWhiteSpace(YAxisLabel) ? "Value" : YAxisLabel;
    private string EffectiveMaxLabel => string.IsNullOrWhiteSpace(MaxLabel) ? "Highest" : MaxLabel;

    private string BarHeightStyle(decimal value) =>
        $"height:{Percent(value)}%;background:{Color}";

    private string BarWidthStyle(decimal value) =>
        $"width:{Percent(value)}%;background:{Color}";

    private string Percent(decimal value)
    {
        var percent = MaxValue <= 0 ? 0 : Math.Max(1m, Math.Min(100m, Math.Abs(value) * 100m / MaxValue));
        return percent.ToString("0.##", CultureInfo.InvariantCulture);
    }

    private string FormatValue(decimal value)
    {
        var rounded = value >= 100 ? value.ToString("0", CultureInfo.InvariantCulture) : value.ToString("0.##", CultureInfo.InvariantCulture);
        return $"{ValuePrefix}{rounded}{ValueSuffix}{(string.IsNullOrWhiteSpace(Unit) ? "" : $" {Unit}")}";
    }

    private static string ShortLabel(string label, int maxLength) =>
        label.Length <= maxLength ? label : $"{label[..Math.Max(1, maxLength - 1)]}...";
}
