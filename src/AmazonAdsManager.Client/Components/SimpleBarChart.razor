@namespace AmazonAdsManager.Client.Components

<div class="simple-chart">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <strong class="small">@Title</strong>
        @if (!string.IsNullOrWhiteSpace(Unit))
        {
            <span class="text-muted" style="font-size:0.75rem">@Unit</span>
        }
    </div>
    @if (!Points.Any())
    {
        <div class="text-muted small py-3">No chart data yet.</div>
    }
    else
    {
        <svg viewBox="0 0 320 150" role="img" aria-label="@Title" style="width:100%;height:150px">
            <line x1="28" y1="126" x2="312" y2="126" stroke="#d8dee6" />
            @{
                var max = Math.Max(1, Points.Max(p => Math.Abs(p.Value)));
                var count = Math.Max(1, Points.Count);
                var barWidth = Math.Max(4, 260m / count - 3);
                var index = 0;
            }
            @foreach (var point in Points)
            {
                var height = Math.Max(2, (decimal)96 * Math.Abs(point.Value) / max);
                var x = 32 + index * (260m / count);
                var y = 126 - height;
                <rect x="@x.ToString("0.##")" y="@y.ToString("0.##")" width="@barWidth.ToString("0.##")" height="@height.ToString("0.##")" rx="2" fill="@Color">
                    <title>@point.Label: @point.Value.ToString("0.##")</title>
                </rect>
                index++;
            }
        </svg>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Unit { get; set; } = "";
    [Parameter] public string Color { get; set; } = "#ff5a00";
    [Parameter] public IReadOnlyList<ChartPointDto> Points { get; set; } = Array.Empty<ChartPointDto>();
}
