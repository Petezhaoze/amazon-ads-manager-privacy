@inject HttpClient Http
@inject IJSRuntime JS

@if (!_unlocked)
{
    <div style="min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#1a1a2e">
        <div style="text-align:center;width:100%;max-width:320px;padding:1rem">

            <div style="font-size:2.5rem;margin-bottom:0.5rem">📦</div>
            <h2 style="color:white;margin:0 0 0.25rem;font-size:1.3rem;font-weight:600">Amazon Ads Manager</h2>
            <p style="color:#aaa;margin:0 0 2rem;font-size:0.85rem">Enter PIN to unlock</p>

            @* Masked input display *@
            <div style="background:#16213e;border:1px solid #2a2a4a;border-radius:8px;padding:0.75rem 1rem;margin-bottom:1rem;min-height:2.8rem;letter-spacing:0.4rem;font-size:1.2rem;color:white;text-align:center">
                @(new string('●', _pin.Length))@(string.IsNullOrEmpty(_pin) ? " " : "")
            </div>

            @if (_error)
            {
                <p style="color:#ef5350;font-size:0.85rem;margin:0 0 0.75rem">Wrong PIN</p>
            }

            @* Number pad *@
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.75rem;margin-bottom:0.75rem">
                @foreach (var n in new[] { "1","2","3","4","5","6","7","8","9" })
                {
                    var digit = n;
                    <button @onclick="() => PressDigit(digit)" disabled="@_checking" style="@DialBtn">@digit</button>
                }
            </div>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.75rem">
                <button @onclick="Backspace" disabled="@_checking"
                        style="@DialBtn;font-size:1.2rem">⌫</button>
                <button @onclick='() => PressDigit("0")' disabled="@_checking"
                        style="@DialBtn">0</button>
                <button @onclick="Submit" disabled="@(_checking || string.IsNullOrEmpty(_pin))"
                        style="@DialBtn;background:#0d6efd;border-color:#0d6efd;font-size:1rem">↵</button>
            </div>

        </div>
    </div>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string _pin = "";
    private bool _unlocked = false;
    private bool _checking = false;
    private bool _error = false;

    private const string DialBtn = "padding:1rem;background:#16213e;color:white;border:1px solid #2a2a4a;border-radius:50%;font-size:1.4rem;font-weight:500;cursor:pointer;aspect-ratio:1;display:flex;align-items:center;justify-content:center;width:100%";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "app_unlocked");
        if (stored == "1") { _unlocked = true; StateHasChanged(); }
    }

    private void PressDigit(string digit)
    {
        if (_checking) return;
        _error = false;
        _pin += digit;
    }

    private void Backspace()
    {
        if (_pin.Length > 0) _pin = _pin[..^1];
        _error = false;
    }

    private async Task Submit()
    {
        if (_checking || string.IsNullOrEmpty(_pin)) return;
        _checking = true;
        try
        {
            var form = new FormUrlEncodedContent(new[] {
                new KeyValuePair<string, string>("password", _pin)
            });
            var resp = await Http.PostAsync("access/check", form);
            if (resp.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", "app_unlocked", "1");
                _unlocked = true;
            }
            else
            {
                _error = true;
                _pin = "";
            }
        }
        catch
        {
            _error = true;
            _pin = "";
        }
        finally
        {
            _checking = false;
        }
    }
}
