@inject HttpClient Http
@inject IJSRuntime JS

@if (!_unlocked)
{
    <div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:#f0f2f5">
        <div style="background:white;border-radius:12px;padding:2.5rem 3rem;box-shadow:0 2px 20px rgba(0,0,0,0.12);width:100%;max-width:380px;text-align:center">
            <div style="font-size:2rem;margin-bottom:0.5rem">📦</div>
            <h2 style="margin:0 0 0.25rem;font-size:1.4rem">Amazon Ads Manager</h2>
            <p style="color:#666;margin:0 0 1.5rem;font-size:0.9rem">Enter the password to continue</p>

            <input type="password"
                   @bind="_password"
                   @bind:event="oninput"
                   @onkeydown="OnKeyDown"
                   placeholder="Password"
                   style="width:100%;padding:0.6rem 0.75rem;border:1px solid #ddd;border-radius:6px;font-size:1rem;box-sizing:border-box;margin-bottom:0.75rem;outline:none" />

            @if (_error)
            {
                <p style="color:#dc3545;font-size:0.85rem;margin:0 0 0.75rem">Incorrect password. Try again.</p>
            }

            <button @onclick="Submit" disabled="@_checking"
                    style="width:100%;padding:0.65rem;background:#0d6efd;color:white;border:none;border-radius:6px;font-size:1rem;cursor:pointer">
                @(_checking ? "Checking…" : "Unlock")
            </button>
        </div>
    </div>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string _password = "";
    private bool _unlocked = false;
    private bool _checking = false;
    private bool _error = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "app_unlocked");
        if (stored == "1") { _unlocked = true; StateHasChanged(); }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Submit();
    }

    private async Task Submit()
    {
        if (_checking || string.IsNullOrWhiteSpace(_password)) return;
        _checking = true;
        _error = false;

        try
        {
            var form = new FormUrlEncodedContent(new[] {
                new KeyValuePair<string, string>("password", _password)
            });
            var resp = await Http.PostAsync("access/check", form);
            if (resp.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", "app_unlocked", "1");
                _unlocked = true;
            }
            else
            {
                _error = true;
                _password = "";
            }
        }
        catch
        {
            _error = true;
        }
        finally
        {
            _checking = false;
        }
    }
}
