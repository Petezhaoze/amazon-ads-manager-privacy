    private IEnumerable<EvidenceCard> FriendlyEvidenceCards(TechnicalRecommendationDetailsDto details)
    {
        if (!details.Evidence.Any())
        {
            yield return new EvidenceCard(
                "Missing Data",
                "No detailed evidence was saved for this recommendation.",
                "The recommendation exists, but the supporting rows are not available in the analytics database yet.",
                ProductDisplayName(selectedProduct!),
                "AI recommendation",
                DateRange(details.Recommendation));
            yield break;
        }

        foreach (var e in details.Evidence)
        {
            var type = EvidenceType(e);
            yield return new EvidenceCard(
                type,
                FriendlyMetricName(e.MetricName),
                EvidenceExplanation(type, e),
                string.IsNullOrWhiteSpace(e.SourceValue) ? EmptyDash(e.Notes) : e.SourceValue,
                FriendlyDataSource(e.SourceType, e.SourceTable),
                DateRange(details.Recommendation));
        }
    }

    private static string EvidenceType(AiRecommendationEvidenceDto e)
    {
        if (e.MetricName.Contains("Winning", StringComparison.OrdinalIgnoreCase)) return "Winner";
        if (e.MetricName.Contains("Inefficient", StringComparison.OrdinalIgnoreCase) ||
            e.MetricName.Contains("spend", StringComparison.OrdinalIgnoreCase)) return "Wasted Spend";
        if (e.SourceType.Contains("AMC", StringComparison.OrdinalIgnoreCase)) return "Hourly Data";
        if (e.MetricName.Contains("hour", StringComparison.OrdinalIgnoreCase)) return "Trend";
        if (e.SourceTable.Contains("Campaign", StringComparison.OrdinalIgnoreCase)) return "Campaign Structure";
        return "Context";
    }

    private static string EvidenceClass(string type) => type switch
    {
        "Winner" => "evidence-card--winner",
        "Wasted Spend" => "evidence-card--waste",
        "Missing Data" => "evidence-card--missing",
        _ => ""
    };

    private static string EvidenceExplanation(string type, AiRecommendationEvidenceDto e)
    {
        var subject = string.IsNullOrWhiteSpace(e.Notes) ? e.SourceValue : e.Notes;
        subject = string.IsNullOrWhiteSpace(subject) ? "This row" : subject;
        return type switch
        {
            "Winner" => $"{subject} is producing stronger return than other targets.",
            "Wasted Spend" => $"{subject} is consuming budget that may not be turning into enough sales.",
            "Hourly Data" => $"{subject} comes from AMC hourly data and supports time-of-day analysis.",
            "Trend" => $"{subject} points to a timing pattern in the selected date range.",
            "Campaign Structure" => $"{subject} helps explain how the campaign is organized.",
            _ => $"{subject} was part of the data sent to the AI."
        };
    }

    private static string FriendlyDataSource(string sourceType, string sourceTable)
    {
        if (sourceType.Contains("AmazonAds", StringComparison.OrdinalIgnoreCase)) return "Amazon Ads reporting";
        if (sourceType.Contains("Scorecard", StringComparison.OrdinalIgnoreCase)) return "Analytics scorecard";
        if (sourceType.Contains("AMC", StringComparison.OrdinalIgnoreCase)) return "AMC";
        return string.IsNullOrWhiteSpace(sourceTable) ? sourceType : sourceTable;
    }

    private static string DateRange(AiRecommendationDto rec) =>
        $"{rec.SourceDateRangeStart:MMM d} - {rec.SourceDateRangeEnd:MMM d, yyyy}";

    private static string? ExtractMoney(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return null;
        var match = Regex.Match(text, @"\$\s?[\d,]+(\.\d{1,2})?");
        return match.Success ? match.Value.Replace(" ", "") : null;
    }

    private static string FormatHour(int hour) =>
        hour == 0 ? "12 AM" : hour < 12 ? $"{hour} AM" : hour == 12 ? "12 PM" : $"{hour - 12} PM";

    private static string ScoreClass(decimal score) =>
        score >= 70 ? "score-pill--high" : score >= 30 ? "score-pill--mid" : "score-pill--low";

    private static string ScoreLabel(decimal score) =>
        score >= 70 ? "High" : score >= 30 ? "Mid" : score > 0 ? "Low" : "—";

    private static string FriendlyMetricName(string metricName)
    {
        var colonIdx = metricName.IndexOf(':');
        var name = colonIdx > 0 ? metricName[..colonIdx].Trim() : metricName;
        return name switch
        {
            var s when s.Contains("Total spend", StringComparison.OrdinalIgnoreCase) => "Total Spend",
            var s when s.Contains("efficiency score", StringComparison.OrdinalIgnoreCase) => "Avg Efficiency",
            var s when s.Contains("conversion hour", StringComparison.OrdinalIgnoreCase) => "Peak Conv. Hour",
            var s when s.Contains("spend hour", StringComparison.OrdinalIgnoreCase) => "Peak Spend Hour",
            _ => name
        };
    }

    private static string FriendlyMetricValue(AiRecommendationEvidenceDto e)
    {
        if (e.MetricName.Contains("hour", StringComparison.OrdinalIgnoreCase) &&
            e.MetricValue >= 0 && e.MetricValue <= 23)
            return FormatHour((int)e.MetricValue);
        if (e.MetricName.Contains("spend", StringComparison.OrdinalIgnoreCase))
            return $"${e.MetricValue:F2}";
        return e.MetricValue.ToString("0.##");
    }

    private string AiModelText =>
        aiStatus is null ? "Checking..." :
        !string.IsNullOrWhiteSpace(aiStatus.Model) ? aiStatus.Model :
        "Not configured";

