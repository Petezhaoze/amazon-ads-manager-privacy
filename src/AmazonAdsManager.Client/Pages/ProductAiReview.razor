@page "/product-ai-review"
@inject AccountState AccountState
@inject AdsApiClient Api
@inject AppPreferencesService Prefs
@implements IDisposable

<PageTitle>Product AI Analysis</PageTitle>

<div class="product-ai-page">
<h1>Product AI Analysis</h1>

@if (AccountState.SelectedAccount is null)
{
    <p class="text-muted">Select an account first.</p>
}
else if (loading)
{
    <p>Loading products with mapped campaigns...</p>
}
else
{
    <div class="d-flex align-items-end gap-2 flex-wrap mb-3">
        <div style="min-width:280px">
            <label class="form-label small text-muted">Product</label>
            <select class="form-select" value="@selectedProductId" @onchange="OnProductChanged">
                <option value="">Select a product with mapped campaigns</option>
                @foreach (var product in FilteredProducts)
                {
                    <option value="@product.Id">@ProductDisplayName(product)</option>
                }
            </select>
        </div>
        <button class="btn btn-primary" @onclick="Analyze" disabled="@(selectedProduct is null || analyzing)">
            @(analyzing ? "Analyzing..." : "Run AI Analysis")
        </button>
        @if (selectedProduct is not null)
        {
            <span class="small text-muted">@selectedProduct.ASIN / @selectedProduct.SKU</span>
        }
    </div>

    @if (!products.Any())
    {
        <div class="alert alert-info">
            No products with mapped campaigns found. Map a campaign to a product before running AI analysis.
        </div>
    }
    else if (!FilteredProducts.Any())
    {
        <div class="alert alert-info">
            No products match current filters. <a href="/settings">Adjust in Settings</a>.
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (selectedProduct is not null)
    {
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <button type="button" class="nav-link @(activeTab == "simple" ? "active" : "")" @onclick='() => activeTab = "simple"'>
                    Simple Recommendations
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(activeTab == "technical" ? "active" : "")" @onclick="OpenTechnicalTab">
                    Technical Details
                </button>
            </li>
        </ul>

        @if (activeTab == "simple")
        {
            <div class="row g-3">
                @if (!recommendations.Any())
                {
                    <div class="col-12">
                        <div class="alert alert-secondary">Run AI Analysis to generate recommendations for this product.</div>
                    </div>
                }
                @foreach (var group in recommendations.GroupBy(r => GroupLabel(r.RecommendationType)))
                {
                    <div class="col-12">
                        <h5 class="mt-2">@group.Key</h5>
                    </div>
                    @foreach (var rec in group)
                    {
                        <div class="col-12 col-xl-6">
                            <div class="card h-100">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <strong>@rec.Title</strong>
                                    <span class="badge @ConfidenceClass(rec.Confidence)">@((rec.Confidence * 100).ToString("F0"))%</span>
                                </div>
                                <div class="card-body">
                                    <div class="small text-muted mb-1">Action</div>
                                    <p class="fw-semibold">@rec.Action</p>
                                    <div class="small text-muted mb-1">Why</div>
                                    <p>@rec.Reason</p>
                                    <div class="small text-muted mb-1">Expected impact</div>
                                    <p>@rec.ExpectedImpact</p>
                                    <div class="small text-muted">
                                        Date range: @rec.SourceDateRangeStart.ToString("MMM d") - @rec.SourceDateRangeEnd.ToString("MMM d, yyyy")
                                    </div>
                                </div>
                                <div class="card-footer d-flex gap-2 flex-wrap">
                                    <button class="btn btn-sm btn-success" @onclick="() => Approve(rec)">Approve</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => Ignore(rec)">Ignore</button>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEdit(rec)">Edit</button>
                                    <button class="btn btn-sm btn-link ms-auto" @onclick="() => SelectTechnical(rec)">Details</button>
                                    @if (editingId == rec.RecommendationId)
                                    {
                                        <div class="w-100 mt-2">
                                            <textarea class="form-control form-control-sm mb-2" rows="2" @bind="editText"></textarea>
                                            <button class="btn btn-sm btn-primary" @onclick="() => SaveEdit(rec)">Save</button>
                                            <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="CancelEdit">Cancel</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <div class="technical-layout">
                <aside class="technical-sidebar">
                    <div class="technical-sidebar__title">Recommendations</div>
                    <div class="list-group recommendation-list">
                        @foreach (var rec in recommendations)
                        {
                            <button type="button"
                                    class="list-group-item list-group-item-action @(selectedRecommendation?.RecommendationId == rec.RecommendationId ? "active" : "")"
                                    @onclick="() => LoadTechnicalDetails(rec)">
                                <div class="fw-semibold">@rec.Title</div>
                                <div class="small">@GroupLabel(rec.RecommendationType) - @((rec.Confidence * 100).ToString("F0"))% confidence</div>
                            </button>
                        }
                    </div>
                </aside>
                <section class="technical-main">
                    @if (technicalLoading)
                    {
                        <div class="technical-loading">
                            <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                            <span>Loading technical details...</span>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(technicalError))
                    {
                        <div class="alert alert-warning d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <strong>Technical details are not available for this recommendation yet.</strong>
                                <div class="small mt-1">@technicalError</div>
                            </div>
                            @if (selectedRecommendation is not null)
                            {
                                <button class="btn btn-sm btn-outline-dark" @onclick="() => LoadTechnicalDetails(selectedRecommendation)">Retry</button>
                            }
                        </div>
                    }
                    else if (technicalDetails is null)
                    {
                        <div class="alert alert-secondary">Select a recommendation to inspect the source data and charts.</div>
                    }
                    else
                    {
                        <div class="technical-summary mb-3">
                            <div>
                                <div class="text-muted small">Selected recommendation</div>
                                <h2>@technicalDetails.Recommendation.Title</h2>
                                <p>@technicalDetails.Recommendation.Action</p>
                            </div>
                            <div class="technical-summary__meta">
                                <span>@GroupLabel(technicalDetails.Recommendation.RecommendationType)</span>
                                <span>@((technicalDetails.Recommendation.Confidence * 100).ToString("F0"))% confidence</span>
                                <span>@technicalDetails.Recommendation.SourceDateRangeStart.ToString("MMM d") - @technicalDetails.Recommendation.SourceDateRangeEnd.ToString("MMM d, yyyy")</span>
                            </div>
                        </div>

                        <div class="chart-grid mb-3">
                            @foreach (var chart in technicalDetails.Charts.Where(c => c.Points.Any()).Take(6))
                            {
                                <div class="chart-panel">
                                    <SimpleBarChart Title="@chart.Name"
                                                    Subtitle="@ChartSubtitle(chart.Name)"
                                                    Points="@chart.Points"
                                                    ValuePrefix="@ChartPrefix(chart.Name)"
                                                    ValueSuffix="@ChartSuffix(chart.Name)"
                                                    XAxisLabel="@ChartXAxis(chart.Name)"
                                                    YAxisLabel="@ChartYAxis(chart.Name)"
                                                    Horizontal="@IsHorizontalChart(chart.Name)" />
                                </div>
                            }
                        </div>

                        <div class="data-panel mb-3">
                            <div class="data-panel__header">Source Evidence</div>
                            <div class="table-responsive">
                                <table class="table table-sm table-readable mb-0">
                                    <thead>
                                        <tr>
                                            <th>Source</th>
                                            <th>Table</th>
                                            <th>Field</th>
                                            <th>Value</th>
                                            <th>Metric</th>
                                            <th>Notes</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in technicalDetails.Evidence)
                                        {
                                            <tr>
                                                <td>@row.SourceType</td>
                                                <td><code>@row.SourceTable</code></td>
                                                <td><code>@row.SourceField</code></td>
                                                <td>@row.SourceValue</td>
                                                <td>@row.MetricName: @row.MetricValue.ToString("0.##")</td>
                                                <td>@row.Notes</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="data-panel mb-3">
                            <div class="data-panel__header">Hourly Scorecard</div>
                            <div class="table-responsive">
                                <table class="table table-sm table-readable mb-0">
                                    <thead>
                                        <tr>
                                            <th>Day</th>
                                            <th>Hour</th>
                                            <th>Spend</th>
                                            <th>Clicks</th>
                                            <th>Impressions</th>
                                            <th>Sales</th>
                                            <th>Purchases</th>
                                            <th>ROAS</th>
                                            <th>ACOS</th>
                                            <th>CPC</th>
                                            <th>CTR</th>
                                            <th>CVR</th>
                                            <th>Score</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in technicalDetails.HourlyScorecard.OrderByDescending(r => r.EfficiencyScore).Take(30))
                                        {
                                            <tr>
                                                <td>@row.DayOfWeek</td>
                                                <td>@row.Hour:00</td>
                                                <td>$@row.Spend.ToString("F2")</td>
                                                <td>@row.Clicks</td>
                                                <td>@row.Impressions</td>
                                                <td>$@row.Sales.ToString("F2")</td>
                                                <td>@row.Purchases</td>
                                                <td>@row.ROAS.ToString("F2")</td>
                                                <td>@row.ACOS.ToString("P1")</td>
                                                <td>$@row.CPC.ToString("F2")</td>
                                                <td>@row.CTR.ToString("P1")</td>
                                                <td>@row.CVR.ToString("P1")</td>
                                                <td>@row.EfficiencyScore.ToString("F0")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </section>
            </div>
        }
    }
}
</div>

@code {
    private List<ProductProfile> products = new();
    private ProductProfile? selectedProduct;
    private string selectedProductId = "";
    private List<AiRecommendationDto> recommendations = new();
    private TechnicalRecommendationDetailsDto? technicalDetails;
    private AiRecommendationDto? selectedRecommendation;
    private bool loading;
    private bool analyzing;
    private bool technicalLoading;
    private string? error;
    private string? technicalError;
    private string activeTab = "simple";
    private string? editingId;
    private string editText = "";

    private IEnumerable<ProductProfile> FilteredProducts => products.Where(p =>
        (!Prefs.HideOutOfStock || p.StockQuantity is null || p.StockQuantity > 0) &&
        (!Prefs.ShowActiveOnly || p.IsActive));

    protected override async Task OnInitializedAsync()
    {
        AccountState.OnChange += OnAccountChanged;
        Prefs.OnChange += StateHasChanged;
        await Prefs.LoadAsync();
        await LoadProducts();
    }

    private async void OnAccountChanged()
    {
        await LoadProducts();
        StateHasChanged();
    }

    private async Task LoadProducts()
    {
        if (AccountState.SelectedAccount is null) return;
        loading = true;
        error = null;
        selectedProduct = null;
        selectedProductId = "";
        recommendations.Clear();
        technicalDetails = null;
        technicalError = null;
        try
        {
            products = await Api.GetProductsWithCampaignsAsync(AccountState.SelectedAccount.AccountKey);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        loading = false;
    }

    private async Task OnProductChanged(ChangeEventArgs e)
    {
        selectedProductId = e.Value?.ToString() ?? "";
        selectedProduct = products.FirstOrDefault(p => p.Id == selectedProductId);
        recommendations.Clear();
        technicalDetails = null;
        selectedRecommendation = null;
        error = null;
        technicalError = null;
        if (selectedProduct is not null && AccountState.SelectedAccount is not null)
            recommendations = await Api.GetRecommendationsV2Async(AccountState.SelectedAccount.AccountKey, selectedProduct.Id);
    }

    private async Task Analyze()
    {
        if (selectedProduct is null || AccountState.SelectedAccount is null) return;
        analyzing = true;
        error = null;
        try
        {
            var result = await Api.AnalyzeProductV2Async(AccountState.SelectedAccount.AccountKey, selectedProduct.Id);
            if (result is null || !result.Success)
                error = result?.Error ?? "AI analysis failed.";
            else
                recommendations = result.V2Recommendations;

            if (recommendations.Any())
                selectedRecommendation = recommendations.First();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        analyzing = false;
    }

    private async Task OpenTechnicalTab()
    {
        activeTab = "technical";
        if (technicalDetails is null && selectedRecommendation is null && recommendations.Any())
            selectedRecommendation = recommendations.First();
        if (technicalDetails is null && selectedRecommendation is not null && string.IsNullOrWhiteSpace(technicalError))
            await LoadTechnicalDetails(selectedRecommendation);
    }

    private async Task LoadTechnicalDetails(AiRecommendationDto rec)
    {
        if (selectedProduct is null || AccountState.SelectedAccount is null) return;
        selectedRecommendation = rec;
        technicalLoading = true;
        technicalError = null;
        activeTab = "technical";
        try
        {
            technicalDetails = await Api.GetRecommendationTechnicalDetailsAsync(
                AccountState.SelectedAccount.AccountKey, selectedProduct.Id, rec.RecommendationId);
        }
        catch (Exception ex)
        {
            technicalDetails = null;
            technicalError = ex.Message;
        }
        finally
        {
            technicalLoading = false;
        }
    }

    private async Task SelectTechnical(AiRecommendationDto rec) => await LoadTechnicalDetails(rec);

    private async Task Approve(AiRecommendationDto rec)
    {
        if (await Api.ApproveRecommendationV2Async(rec.RecommendationId))
            rec.Status = "Approved";
    }

    private async Task Ignore(AiRecommendationDto rec)
    {
        if (await Api.IgnoreRecommendationV2Async(rec.RecommendationId))
            rec.Status = "Ignored";
    }

    private void StartEdit(AiRecommendationDto rec)
    {
        editingId = rec.RecommendationId;
        editText = rec.Action;
    }

    private void CancelEdit()
    {
        editingId = null;
        editText = "";
    }

    private async Task SaveEdit(AiRecommendationDto rec)
    {
        if (string.IsNullOrWhiteSpace(editText)) return;
        if (await Api.EditRecommendationV2Async(rec.RecommendationId, editText))
        {
            rec.Action = editText;
            rec.Status = "Edited";
            CancelEdit();
        }
    }

    private static string ProductDisplayName(ProductProfile product)
    {
        if (IsPlaceholderProductName(product)) return "Product title unavailable";
        var displayName = product.DisplayName.Trim();
        var firstComma = displayName.IndexOf(',');
        return firstComma > 0 ? displayName[..firstComma].Trim() : displayName;
    }

    private static bool IsPlaceholderProductName(ProductProfile product)
    {
        var displayName = product.DisplayName?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(displayName)) return true;
        if (displayName.StartsWith("Sponsored Ad", StringComparison.OrdinalIgnoreCase)) return true;
        if (displayName.Equals(product.ASIN, StringComparison.OrdinalIgnoreCase)) return true;
        if (displayName.Equals(product.SKU, StringComparison.OrdinalIgnoreCase)) return true;
        return displayName.Equals($"{product.ASIN} / {product.SKU}", StringComparison.OrdinalIgnoreCase);
    }

    private static string GroupLabel(string type) => type switch
    {
        "Dayparting" => "Dayparting",
        "Budget" => "Budget",
        "KeywordHarvest" or "NegativeKeyword" or "BidIncrease" or "BidDecrease" => "Keyword/Search Term",
        "CampaignStructure" => "Campaign Structure",
        "ProductConversion" => "Product/ASIN",
        "ExperimentLearning" => "Learning/Experiment",
        _ => "Other"
    };

    private static string ConfidenceClass(decimal confidence) =>
        confidence >= 0.8m ? "bg-success" : confidence >= 0.65m ? "bg-warning text-dark" : "bg-secondary";

    private static bool IsHorizontalChart(string chartName) =>
        chartName.Contains("Keyword", StringComparison.OrdinalIgnoreCase) ||
        chartName.Contains("Before vs after", StringComparison.OrdinalIgnoreCase);

    private static string ChartPrefix(string chartName) =>
        chartName.Contains("spend", StringComparison.OrdinalIgnoreCase) ||
        chartName.Contains("sales", StringComparison.OrdinalIgnoreCase) ? "$" : "";

    private static string ChartSuffix(string chartName) =>
        chartName.Contains("ROAS", StringComparison.OrdinalIgnoreCase) ? "x" : "";

    private static string ChartXAxis(string chartName) =>
        chartName.StartsWith("Hourly", StringComparison.OrdinalIgnoreCase) ? "Hour of day" : "";

    private static string ChartYAxis(string chartName) =>
        chartName.Contains("conversions", StringComparison.OrdinalIgnoreCase) ? "Purchases" :
        chartName.Contains("spend", StringComparison.OrdinalIgnoreCase) ? "Spend" :
        chartName.Contains("sales", StringComparison.OrdinalIgnoreCase) ? "Sales" :
        chartName.Contains("ROAS", StringComparison.OrdinalIgnoreCase) ? "ROAS" : "Value";

    private static string ChartSubtitle(string chartName) =>
        chartName.Contains("Keyword", StringComparison.OrdinalIgnoreCase) ? "Top search terms by return" :
        chartName.Contains("Before vs after", StringComparison.OrdinalIgnoreCase) ? "Learning from approved changes" :
        "Aggregated from scorecard rows";

    public void Dispose()
    {
        AccountState.OnChange -= OnAccountChanged;
        Prefs.OnChange -= StateHasChanged;
    }
}
