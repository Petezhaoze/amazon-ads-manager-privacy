    private IEnumerable<ChartSeriesDto> UsefulCharts(TechnicalRecommendationDetailsDto details)
    {
        var hasHourlyData = details.HourlyScorecard.Any(r => r.Spend > 0 || r.Sales > 0 || r.Purchases > 0);
        return details.Charts
            .Where(c => c.Points.Any())
            .Where(c => hasHourlyData || !c.Name.StartsWith("Hourly", StringComparison.OrdinalIgnoreCase))
            .Where(c => !c.Name.Equals("Keyword ROAS", StringComparison.OrdinalIgnoreCase));
    }

    private IEnumerable<KeywordPerformanceDto> SortedTargetRows(TechnicalRecommendationDetailsDto details)
    {
        var rows = details.KeywordPerformance.AsEnumerable();
        return targetSort switch
        {
            "roas" => rows.OrderByDescending(r => r.ROAS).ThenByDescending(r => r.Sales),
            "spend" => rows.OrderByDescending(r => r.Spend),
            "acos" => rows.OrderByDescending(r => r.Sales > 0 ? r.ACOS : decimal.MaxValue),
            "sales" => rows.OrderByDescending(r => r.Sales),
            "clicks" => rows.OrderByDescending(r => r.Clicks),
            "orders" => rows.OrderByDescending(r => r.Purchases),
            _ => rows.OrderByDescending(WastedSpend).ThenByDescending(r => r.Spend)
        };
    }

    private static decimal WastedSpend(KeywordPerformanceDto row)
    {
        if (row.Spend <= 0) return 0;
        if (row.Sales <= 0) return row.Spend;
        if (row.ACOS > 0.45m) return row.Spend * Math.Min(row.ACOS, 2m);
        return 0;
    }

    private static string TargetStatus(KeywordPerformanceDto row)
    {
        if (row.Spend > 0 && row.Sales <= 0) return "Pause";
        if (row.ACOS > 0.45m && row.Sales > 0) return "Reduce";
        if (row.ROAS >= 3m && row.Purchases > 0) return "Scale";
        return "Keep";
    }

    private static string TargetStatusClass(KeywordPerformanceDto row) => TargetStatus(row) switch
    {
        "Scale" => "target-status--scale",
        "Reduce" => "target-status--reduce",
        "Pause" => "target-status--pause",
        _ => "target-status--keep"
    };

    private static decimal Cpc(KeywordPerformanceDto row) =>
        row.Clicks > 0 ? row.Spend / row.Clicks : 0;

