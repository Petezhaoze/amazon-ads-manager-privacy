@page "/product-ai-review"
@inject AccountState AccountState
@inject AdsApiClient Api
@inject AppPreferencesService Prefs
@implements IDisposable

<PageTitle>Product AI Review</PageTitle>

<h1>Product AI Review</h1>

@if (AccountState.SelectedAccount is null)
{
    <p class="text-muted">Select an account first.</p>
}
else
{
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Select Product</span>
            <span class="small text-muted">Showing @FilteredProducts.Count() of @products.Count</span>
        </div>
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2 mb-3">
                @foreach (var p in FilteredProducts)
                {
                    var imgUrl = _imageUrls.TryGetValue(p.ASIN, out var u) ? u : null;
                    var isSelected = selectedProduct?.Id == p.Id;
                    var displayName = ProductDisplayName(p);
                    <div class="d-flex flex-column align-items-center p-2 rounded border @(isSelected ? "border-primary border-2 bg-primary bg-opacity-10" : "border-secondary")"
                         style="width:100px;cursor:pointer;transition:box-shadow .15s"
                         @onclick="() => SelectProduct(p)">
                        @if (imgUrl is not null)
                        {
                            <img src="@imgUrl" alt="@displayName"
                                 style="width:60px;height:60px;object-fit:contain;border-radius:4px;background:#f8f9fa" />
                        }
                        else
                        {
                            <div style="width:60px;height:60px;background:#f0f0f0;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:1.5rem">📦</div>
                        }
                        <div class="small fw-semibold text-center mt-1" style="word-break:break-word;line-height:1.2;max-width:90px">@displayName</div>
                        <div class="text-muted" style="font-size:0.65rem">@p.ASIN</div>
                        @if (p.StockQuantity == 0)
                        {
                            <span class="badge bg-danger mt-1" style="font-size:0.6rem">0 stock</span>
                        }
                    </div>
                }
                @if (!FilteredProducts.Any())
                {
                    <p class="text-muted small mb-0">No products match current filters. <a href="/settings">Adjust in Settings</a>.</p>
                }
            </div>
            <button class="btn btn-primary btn-sm" @onclick="Analyze" disabled="@(selectedProduct is null || analyzing)">
                @(analyzing ? "Analyzing..." : "Analyze Product")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (trend is not null)
    {
        <div class="card mb-3 border-secondary">
            <div class="card-header bg-secondary text-white">
                <strong>Product Trend: @(selectedProduct is null ? trend.ProductName : ProductDisplayName(selectedProduct))</strong>
                <span class="float-end small">@trend.ASIN / @trend.SKU</span>
            </div>
            @if (trend.IsSyntheticMetrics)
            {
                <div class="alert alert-warning mb-0 rounded-0 py-2 px-3 small border-0">
                    <strong>⚠️ Simulated metrics</strong> — No real ad performance data is available for this product yet. The figures below are AI-generated estimates based on your target ACOS and daily budget. Connect the Amazon Ads Reporting API for real data.
                </div>
            }
            <div class="card-body">
                <div class="row g-2 text-center">
                    <div class="col-6 col-md-3">
                        <div class="fw-semibold small text-muted">7-Day ACOS</div>
                        <div class="@(trend.Last7DaysAcos > trend.TargetAcos ? "text-danger fw-bold" : "text-success fw-bold")">
                            @(trend.Last7DaysAcos.ToString("P1"))
                        </div>
                        <div class="small text-muted">Target: @(trend.TargetAcos.ToString("P1"))</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="fw-semibold small text-muted">Spend</div>
                        <div>$@(trend.Last7DaysSpend.ToString("F2"))</div>
                        <div class="small @TrendArrowClass(trend.SpendChangePercent)">
                            @TrendArrow(trend.SpendChangePercent) @Abs(trend.SpendChangePercent).ToString("F1")%
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="fw-semibold small text-muted">Sales</div>
                        <div>$@(trend.Last7DaysSales.ToString("F2"))</div>
                        <div class="small @TrendArrowClass(trend.SalesChangePercent)">
                            @TrendArrow(trend.SalesChangePercent) @Abs(trend.SalesChangePercent).ToString("F1")%
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="fw-semibold small text-muted">Clicks / Orders</div>
                        <div>@trend.Last7DaysClicks / @trend.Last7DaysOrders</div>
                        <div class="small text-muted">last 7 days</div>
                    </div>
                </div>
                @if (trend.TrendNotes.Any())
                {
                    <hr class="my-2" />
                    <ul class="mb-0 small">
                        @foreach (var note in trend.TrendNotes)
                        {
                            <li>@note</li>
                        }
                    </ul>
                }
            </div>
        </div>
    }

    @if (recommendations.Any())
    {
        <h5 class="mt-2">AI Recommendations (@recommendations.Count)</h5>

        @foreach (var rec in recommendations)
        {
            var previews = actionPreviews.ContainsKey(rec.Id) ? actionPreviews[rec.Id] : new();

            <div class="card mb-3 @GetSeverityBorderClass(rec.Severity)">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge @GetSeverityBadgeClass(rec.Severity) me-2">@rec.Severity</span>
                        <strong>@GetProblemLabel(rec.RecommendationType)</strong>
                    </div>
                    <span class="badge @GetStatusBadgeClass(rec.Status)">@rec.Status</span>
                </div>
                <div class="card-body p-0">

                    @* Problem *@
                    <div class="px-3 py-2 border-bottom">
                        <div class="small text-muted fw-semibold mb-1" style="letter-spacing:.05em">PROBLEM</div>
                        <div class="fw-semibold" style="color:#dc3545">@GetProblemLabel(rec.RecommendationType)</div>
                        @if (rec.SuggestedBudgetChangePercent.HasValue)
                        {
                            <div class="small text-muted mt-1">Budget change: <strong>@rec.SuggestedBudgetChangePercent.Value.ToString("+0.0;-0.0;0.0")%</strong></div>
                        }
                    </div>

                    @* AI Recommendation *@
                    <div class="px-3 py-2 border-bottom">
                        <div class="small text-muted fw-semibold mb-1" style="letter-spacing:.05em">AI RECOMMENDATION</div>
                        <p class="mb-1">@rec.Explanation</p>
                        <p class="mb-0 fst-italic text-muted small">@rec.SuggestedAction</p>
                        @if (!string.IsNullOrEmpty(rec.SuggestedDayparting))
                        {
                            <div class="small mt-1">Dayparting: <code>@rec.SuggestedDayparting</code></div>
                        }
                    </div>

                    @* Proposed Action Preview *@
                    @if (previews.Any())
                    {
                        <div class="px-3 py-2 border-bottom">
                            <div class="small text-muted fw-semibold mb-2" style="letter-spacing:.05em">PROPOSED ACTION</div>
                            @{ var previewIdx = 0; }
                            @foreach (var preview in previews)
                            {
                                <div class="d-flex align-items-start gap-2 @(previewIdx++ > 0 ? "mt-2" : "")">
                                    <span class="badge @GetRiskBadgeClass(preview.RiskLevel) mt-1" style="white-space:nowrap">@preview.RiskLevel Risk</span>
                                    <div>
                                        <div class="fw-semibold small">@GetActionTypeLabel(preview.ActionType): @preview.Summary</div>
                                        <div class="small text-muted mt-1" style="white-space:pre-wrap;line-height:1.5">@preview.Details</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @* Approve / Ignore / Edit *@
                    <div class="px-3 py-2">
                        @if (rec.Status == "Pending")
                        {
                            @if (editingId == rec.Id)
                            {
                                <div class="mb-2">
                                    <textarea class="form-control form-control-sm" rows="2"
                                              placeholder="Describe your custom action..."
                                              @bind="editText" />
                                </div>
                                <button class="btn btn-sm btn-primary me-1" @onclick="() => SaveEdit(rec.Id)">Save Edit</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-success me-1" @onclick="() => Approve(rec.Id)">✓ Approve</button>
                                <button class="btn btn-sm btn-warning me-1" @onclick="() => Ignore(rec.Id)">✗ Ignore</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => StartEdit(rec.Id)">✎ Edit</button>
                            }
                        }
                        else if (rec.Status == "Edited" && !string.IsNullOrEmpty(editedActions.GetValueOrDefault(rec.Id)))
                        {
                            <div class="small text-muted fst-italic">Edited: @editedActions[rec.Id]</div>
                        }
                    </div>

                </div>
            </div>
        }

        <button class="btn btn-outline-secondary btn-sm mt-1" @onclick="ExportTrainingData">📥 Export Training Data</button>
    }
}

@code {
    private List<ProductProfile> products = new();
    private Dictionary<string, string?> _imageUrls = new();
    private ProductProfile? selectedProduct;
    private List<ProductAiRecommendation> recommendations = new();
    private Dictionary<string, List<ProductActionPreview>> actionPreviews = new();
    private ProductTrendSummary? trend;
    private bool analyzing;
    private string? error;

    private string? editingId;
    private string editText = "";
    private Dictionary<string, string> editedActions = new();

    private IEnumerable<ProductProfile> FilteredProducts => products.Where(p =>
        (!Prefs.HideOutOfStock || p.StockQuantity is null || p.StockQuantity > 0) &&
        (!Prefs.ShowActiveOnly || p.IsActive));

    protected override async Task OnInitializedAsync()
    {
        AccountState.OnChange += OnAccountChanged;
        Prefs.OnChange += StateHasChanged;
        await Prefs.LoadAsync();
        if (AccountState.SelectedAccount is null) return;
        await LoadProducts();
    }

    private async void OnAccountChanged()
    {
        await LoadProducts();
        StateHasChanged();
    }

    private async Task LoadProducts()
    {
        if (AccountState.SelectedAccount is null) return;
        products = await Api.GetProductsAsync(AccountState.SelectedAccount.AccountKey);
        _ = LoadImagesAsync(products.Select(p => p.ASIN).Distinct().ToList());
    }

    private async Task LoadImagesAsync(List<string> asins)
    {
        foreach (var asin in asins)
        {
            if (string.IsNullOrEmpty(asin) || _imageUrls.ContainsKey(asin)) continue;
            _imageUrls[asin] = null;
            var url = await Api.GetProductImageUrlAsync(asin);
            _imageUrls[asin] = url;
            StateHasChanged();
        }
    }

    private void SelectProduct(ProductProfile p)
    {
        if (selectedProduct?.Id == p.Id) return;
        selectedProduct = p;
        recommendations.Clear();
        actionPreviews.Clear();
        trend = null;
        error = null;
        editingId = null;
        editedActions.Clear();
    }

    public void Dispose()
    {
        AccountState.OnChange -= OnAccountChanged;
        Prefs.OnChange -= StateHasChanged;
    }

    private async Task Analyze()
    {
        if (selectedProduct is null || AccountState.SelectedAccount is null) return;
        analyzing = true;
        error = null;
        try
        {
            var result = await Api.AnalyzeProductAsync(AccountState.SelectedAccount.AccountKey, selectedProduct.Id);
            if (result is not null && result.Success)
            {
                recommendations = result.Recommendations;
                actionPreviews = result.ActionPreviews;
                trend = result.Trend;
            }
            else
            {
                error = result?.Error ?? "Analysis failed";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        analyzing = false;
    }

    private async Task Approve(string recommendationId)
    {
        await Api.ApproveRecommendationAsync(recommendationId);
        var rec = recommendations.FirstOrDefault(r => r.Id == recommendationId);
        if (rec is not null) rec.Status = "Approved";
    }

    private async Task Ignore(string recommendationId)
    {
        await Api.IgnoreRecommendationAsync(recommendationId);
        var rec = recommendations.FirstOrDefault(r => r.Id == recommendationId);
        if (rec is not null) rec.Status = "Ignored";
    }

    private void StartEdit(string recommendationId)
    {
        editingId = recommendationId;
        editText = "";
    }

    private void CancelEdit()
    {
        editingId = null;
        editText = "";
    }

    private async Task SaveEdit(string recommendationId)
    {
        if (string.IsNullOrWhiteSpace(editText)) return;
        await Api.EditRecommendationAsync(recommendationId, editText);
        var rec = recommendations.FirstOrDefault(r => r.Id == recommendationId);
        if (rec is not null) rec.Status = "Edited";
        editedActions[recommendationId] = editText;
        editingId = null;
        editText = "";
    }

    private void ExportTrainingData()
    {
        // TODO: Implement download or display JSONL export
    }

    private string GetProblemLabel(string recType) => recType switch
    {
        "ReduceBudget" => "Overspending / High ACOS",
        "IncreaseBudget" => "Budget-limited / Underperforming",
        "PauseOvernight" => "Inefficient overnight ad spend",
        "AdjustDayparting" => "Suboptimal ad scheduling",
        "PauseLowPerformer" => "Low-performing campaign detected",
        "IncreaseHighPerformerBudget" => "High-performer needs more budget",
        "AddNegativeKeyword" => "Irrelevant keyword traffic",
        "MoveBudgetToBetterCampaign" => "Budget misallocated across campaigns",
        "WatchOnly" => "Performance anomaly — monitoring only",
        _ => recType
    };

    private static string ProductDisplayName(ProductProfile product)
    {
        if (IsPlaceholderProductName(product)) return "Product title unavailable";

        var displayName = product.DisplayName.Trim();
        var firstComma = displayName.IndexOf(',');
        return firstComma > 0 ? displayName[..firstComma].Trim() : displayName;
    }

    private static bool IsPlaceholderProductName(ProductProfile product)
    {
        var displayName = product.DisplayName?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(displayName)) return true;
        if (displayName.StartsWith("Sponsored Ad", StringComparison.OrdinalIgnoreCase)) return true;
        if (displayName.Equals(product.ASIN, StringComparison.OrdinalIgnoreCase)) return true;
        if (displayName.Equals(product.SKU, StringComparison.OrdinalIgnoreCase)) return true;
        return displayName.Equals($"{product.ASIN} / {product.SKU}", StringComparison.OrdinalIgnoreCase);
    }

    private string GetActionTypeLabel(string actionType) => actionType switch
    {
        "UpdateSchedule" => "Update Schedule",
        "ReduceBudget" => "Reduce Budget",
        "IncreaseBudget" => "Increase Budget",
        "PauseCampaign" => "Pause Campaign",
        "OptimizeKeywords" => "Optimize Keywords/Targeting",
        "WatchOnly" => "Watch Only",
        "NoAction" => "No Action",
        _ => actionType
    };

    private string GetSeverityBorderClass(string severity) => severity switch
    {
        "High" => "border-danger",
        "Medium" => "border-warning",
        "Low" => "border-info",
        _ => "border-secondary"
    };

    private string GetSeverityBadgeClass(string severity) => severity switch
    {
        "High" => "bg-danger",
        "Medium" => "bg-warning text-dark",
        "Low" => "bg-info text-dark",
        _ => "bg-secondary"
    };

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Approved" => "bg-success",
        "Ignored" => "bg-secondary",
        "Edited" => "bg-info text-dark",
        _ => "bg-warning text-dark"
    };

    private string GetRiskBadgeClass(string risk) => risk switch
    {
        "High" => "bg-danger",
        "Medium" => "bg-warning text-dark",
        _ => "bg-success"
    };

    private string TrendArrow(decimal change) => change >= 0 ? "▲" : "▼";

    private string TrendArrowClass(decimal change) => change >= 0 ? "text-success" : "text-danger";

    private decimal Abs(decimal value) => Math.Abs(value);
}
