@page "/product-ai-review"
@inject AccountState AccountState
@inject AdsApiClient Api
@inject AppPreferencesService Prefs
@inject Microsoft.JSInterop.IJSRuntime JS
@implements IDisposable
@using System.Globalization
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Product AI Analysis</PageTitle>

<div class="product-ai-page">
<h1>Product AI Analysis</h1>

@if (AccountState.SelectedAccount is null)
{
    <p class="text-muted">Select an account first.</p>
}
else if (loading)
{
    <p>Loading products with mapped campaigns...</p>
}
else
{
    <div class="ai-runtime-status @(aiStatus?.IsConfigured == true ? "is-configured" : "is-warning")">
        <span class="ai-runtime-status__label">AI model</span>
        <strong>@AiModelText</strong>
        @if (!string.IsNullOrWhiteSpace(aiStatus?.Message))
        {
            <span class="ai-runtime-status__message">@aiStatus.Message</span>
        }
    </div>

    <div class="product-picker">
        <div class="product-picker__header">
            <div>
                <label class="form-label small text-muted mb-1">Product</label>
                <div class="product-picker__hint">Choose a mapped product to review its ad performance.</div>
            </div>
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="aiActiveCampaignProducts"
                       checked="@Prefs.ShowAiProductsWithActiveCampaignsOnly"
                       @onchange="e => SetActiveCampaignProductFilter((bool)e.Value!)" />
                <label class="form-check-label small" for="aiActiveCampaignProducts">Active mapped campaigns only</label>
            </div>
        </div>

        @if (FilteredProducts.Any())
        {
            <div class="product-picker__grid">
                @foreach (var product in FilteredProducts)
                {
                    var displayName = ProductDisplayName(product);
                    <button type="button"
                            class="product-picker__card @(selectedProductId == product.Id ? "is-selected" : "")"
                            @onclick="() => SelectProduct(product)">
                        <div class="product-picker__image">
                            @if (_imageUrls.TryGetValue(product.ASIN, out var imgUrl) && imgUrl is not null)
                            {
                                <img src="@imgUrl" alt="@displayName" />
                            }
                            else
                            {
                                <span>Box</span>
                            }
                        </div>
                        <div class="product-picker__body">
                            <div class="product-picker__name">@displayName</div>
                            <div class="product-picker__meta">@product.ASIN / @product.SKU</div>
                            <div class="product-picker__badges">
                                <span class="badge @(product.IsActive ? "bg-success" : "bg-secondary")">@(product.IsActive ? "Active" : "Inactive")</span>
                                @if (product.StockQuantity == 0)
                                {
                                    <span class="badge bg-danger">0 stock</span>
                                }
                            </div>
                        </div>
                    </button>
                }
            </div>
        }
    </div>

    @if (selectedProduct is not null)
    {
        <div class="selected-product-bar">
            <div>
                <strong>@ProductDisplayName(selectedProduct)</strong>
                <span class="text-muted small ms-2">@selectedProduct.ASIN / @selectedProduct.SKU</span>
            </div>
            <div class="analysis-controls">
                <div class="date-range-controls">
                    <div class="btn-group btn-group-sm" role="group" aria-label="Date range">
                        <button type="button" class="btn @(dateRangeMode == "day" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetDateRangeMode("day")'>Day</button>
                        <button type="button" class="btn @(dateRangeMode == "week" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetDateRangeMode("week")'>Week</button>
                        <button type="button" class="btn @(dateRangeMode == "custom" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetDateRangeMode("custom")'>Custom</button>
                    </div>
                    <div class="date-inputs">
                        @if (dateRangeMode == "day")
                        {
                            <label class="date-input-label">
                                Date
                                <input type="date" class="form-control form-control-sm" value="@dateRangeEndText" @onchange="OnEndDateChanged" />
                            </label>
                        }
                        else if (dateRangeMode == "custom")
                        {
                            <label class="date-input-label">
                                From
                                <input type="date" class="form-control form-control-sm" value="@dateRangeStartText" @onchange="OnStartDateChanged" />
                            </label>
                            <label class="date-input-label">
                                To
                                <input type="date" class="form-control form-control-sm" value="@dateRangeEndText" @onchange="OnEndDateChanged" />
                            </label>
                        }
                        else
                        {
                            <span class="date-range-summary">@EffectiveDateRangeStart.ToString("MMM d") - @EffectiveDateRangeEnd.ToString("MMM d, yyyy")</span>
                        }
                    </div>
                </div>
                <button class="btn btn-primary" @onclick="Analyze" disabled="@analyzing">
                    @(analyzing ? "Analyzing..." : "Run AI Analysis")
                </button>
            </div>
        </div>
    }

    @if (!products.Any())
    {
        <div class="alert alert-info">
            No products with mapped campaigns found. Map a campaign to a product before running AI analysis.
        </div>
    }
    else if (!FilteredProducts.Any())
    {
        <div class="alert alert-info">
            No products match current filters. <a href="/settings">Adjust in Settings</a>.
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">@error</div>
    }
    @if (!string.IsNullOrWhiteSpace(amcAutoQueryNotice))
    {
        <div class="alert alert-info">@amcAutoQueryNotice</div>
    }
    @if (amcStatus is not null && !amcStatus.IsAuthorized)
    {
        <div class="alert alert-warning amc-status-alert">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <strong>AMC reporting API is not authorized yet, so this page cannot analyze conversion by hour.</strong>
                    <div>Amazon Ads reporting is still available, so keyword, target, and campaign recommendations can still run.</div>
                    @if (!string.IsNullOrWhiteSpace(amcStatus.DiscoveryWarning))
                    {
                        <div class="small mt-1">@amcStatus.DiscoveryWarning</div>
                    }
                    <details class="amc-dev-details mt-2">
                        <summary>Developer details</summary>
                        <div class="small mt-1">@amcStatus.Message</div>
                        @if (amcStatus.AmcAccountCount == 0)
                        {
                            <div class="small mt-1">
                                Amazon returns zero AMC accounts for On-Demand AMC. This is expected; the app will use the configured Sponsored Ads entity and AMC instance.
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(amcStatus.Error))
                        {
                            <div class="small mt-1">Amazon response: @amcStatus.Error</div>
                        }
                        <div class="small mt-2">
                            Instance: <code>@EmptyDash(amcStatus.InstanceId)</code>
                            <span class="mx-1">|</span>
                            Entity: <code>@EmptyDash(amcStatus.AdvertiserId)</code>
                            <span class="mx-1">|</span>
                            Endpoint: <code>@EmptyDash(amcStatus.ApiEndpoint)</code>
                            <span class="mx-1">|</span>
                            Expected user: <code>@EmptyDash(amcStatus.ExpectedAmazonUserEmail)</code>
                            <span class="mx-1">|</span>
                            AMC accounts visible to token: @amcStatus.AmcAccountCount
                            <span class="mx-1">|</span>
                            Instance API: @(amcStatus.InstancesHttpStatus?.ToString() ?? "-")
                            <span class="mx-1">|</span>
                            Instances: @amcStatus.InstanceCount
                            @if (!string.IsNullOrWhiteSpace(amcStatus.InstanceCreationStatus))
                            {
                                <span class="mx-1">|</span>
                                <span>Status: @amcStatus.InstanceCreationStatus</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(amcStatus.LastRequestDiagnostics))
                        {
                            <pre class="small mt-2 mb-0 amc-diagnostics">@amcStatus.LastRequestDiagnostics</pre>
                        }
                    </details>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a class="btn btn-sm btn-outline-dark" href="/settings">Reconnect Amazon as @EmptyDash(amcStatus.ExpectedAmazonUserEmail)</a>
                </div>
            </div>
        </div>
    }
    @foreach (var warning in VisibleAnalysisWarnings)
    {
        <div class="alert alert-warning">@warning</div>
    }
    @if (amcWorkflowSqlByType.Any())
    {
        <details class="amc-sql-details mb-3">
            <summary>AMC workflow SQL (copy into the AMC console to verify the query)</summary>
            @foreach (var pair in amcWorkflowSqlByType)
            {
                <div class="mt-2">
                    <div class="small text-muted">@pair.Key</div>
                    <pre class="small mb-1 amc-sql-block">@pair.Value</pre>
                </div>
            }
        </details>
    }

    @if (selectedProduct is not null)
    {
        var summary = BuildSummary();
        <section class="decision-summary">
            <div class="decision-summary__headline">
                <span class="status-badge @StatusClass(summary.Status)">@summary.Status</span>
                <div>
                    <h2>@summary.ActionSummary</h2>
                    <p>@summary.MainProblem</p>
                </div>
            </div>
            <div class="summary-metrics">
                <div class="summary-metric">
                    <span>Money affected</span>
                    <strong>@summary.MoneyAtRisk</strong>
                    <small>Spend or sales mentioned by the AI</small>
                </div>
                <div class="summary-metric">
                    <span>Best opportunity</span>
                    <strong>@summary.BestOpportunity</strong>
                    <small>Where to focus first</small>
                </div>
                <div class="summary-metric">
                    <span>Data quality</span>
                    <strong>@summary.DataQuality</strong>
                    <small>@summary.DataQualityNote</small>
                </div>
            </div>
        </section>

        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <button type="button" class="nav-link @(activeTab == "simple" ? "active" : "")" @onclick='() => activeTab = "simple"'>
                    Simple Recommendations
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(activeTab == "technical" ? "active" : "")" @onclick="OpenTechnicalTab">
                    Technical Details
                </button>
            </li>
        </ul>

        @if (activeTab == "simple")
        {
            <div class="recommendation-dashboard">
                @if (!recommendations.Any())
                {
                    <div class="empty-recommendation-state">
                        <strong>@(string.IsNullOrWhiteSpace(error) ? "No AI recommendations yet." : "AI analysis failed. No AI recommendations were generated.")</strong>
                        <p>@(string.IsNullOrWhiteSpace(error)
                            ? "Run AI Analysis after importing real Amazon Ads reporting data for this product and date range."
                            : "Fix the error above, then run the analysis again. The app will not show fake fallback recommendations.")</p>
                    </div>
                }
                @foreach (var group in OrderedRecommendations.GroupBy(r => GroupLabel(r.RecommendationType)))
                {
                    <div class="recommendation-group">
                        <div class="recommendation-group__title">@group.Key</div>
                        <div class="recommendation-card-grid">
                            @foreach (var rec in group)
                            {
                                var priority = PriorityLabel(rec);
                                <article class="action-card @PriorityClass(priority)">
                                    <div class="action-card__topline">
                                        <span class="priority-badge">@priority Priority</span>
                                        <span class="confidence-chip">@((rec.Confidence * 100).ToString("F0"))% confident</span>
                                    </div>
                                    <h3>@PlainActionTitle(rec)</h3>
                                    <div class="action-card__section">
                                        <span>What to change</span>
                                        <p>@rec.Action</p>
                                    </div>
                                    <div class="action-card__section">
                                        <span>Why it matters</span>
                                        <p>@rec.Reason</p>
                                    </div>
                                    <div class="action-card__facts">
                                        <div>
                                            <span>Estimated impact</span>
                                            <strong>@rec.ExpectedImpact</strong>
                                        </div>
                                        <div>
                                            <span>Data used</span>
                                            <strong>@DataUsedLabel(rec)</strong>
                                        </div>
                                    </div>
                                    <div class="action-card__footer">
                                        <button class="btn btn-sm btn-success" @onclick="() => Approve(rec)">Review &amp; Apply</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ExplainChinese(rec)">我是傻瓜</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => Ignore(rec)">Ignore</button>
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEdit(rec)">Edit</button>
                                        <button class="btn btn-sm btn-link ms-auto" @onclick="() => SelectTechnical(rec)">View explanation</button>
                                    </div>
                                    @if (editingId == rec.RecommendationId)
                                    {
                                        <div class="mt-2">
                                            <textarea class="form-control form-control-sm mb-2" rows="2" @bind="editText"></textarea>
                                            <button class="btn btn-sm btn-primary" @onclick="() => SaveEdit(rec)">Save</button>
                                            <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="CancelEdit">Cancel</button>
                                        </div>
                                    }
                                </article>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="technical-main">
                @if (recommendations.Any())
                {
                    <div class="recommendation-tabs" role="tablist" aria-label="Recommendations">
                        @foreach (var rec in OrderedRecommendations)
                        {
                            <button type="button"
                                    class="recommendation-tab @(selectedRecommendation?.RecommendationId == rec.RecommendationId ? "is-active" : "")"
                                    @onclick="() => LoadTechnicalDetails(rec)">
                                <div class="fw-semibold">@rec.Title</div>
                                <div class="small">@GroupLabel(rec.RecommendationType) - @((rec.Confidence * 100).ToString("F0"))% confidence</div>
                            </button>
                        }
                    </div>
                }

                    @if (technicalLoading)
                    {
                        <div class="technical-loading">
                            <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                            <span>Loading technical details...</span>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(technicalError))
                    {
                        <div class="alert alert-warning d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <strong>Technical details are not available for this recommendation yet.</strong>
                                <div class="small mt-1">@technicalError</div>
                            </div>
                            @if (selectedRecommendation is not null)
                            {
                                <button class="btn btn-sm btn-outline-dark" @onclick="() => LoadTechnicalDetails(selectedRecommendation)">Retry</button>
                            }
                        </div>
                    }
                    else if (technicalDetails is null)
                    {
                        <div class="alert alert-secondary">Select a recommendation to inspect the source data and charts.</div>
                    }
                    else
                    {
                        var diagnosis = BuildDiagnosis(technicalDetails);
                        <section class="diagnosis-panel mb-3">
                            <div class="diagnosis-panel__header">
                                <span class="status-badge @StatusClass(diagnosis.Priority)">@diagnosis.Priority Priority</span>
                                <div>
                                    <div class="text-muted small">Diagnosis</div>
                                    <h2>@diagnosis.ProblemType</h2>
                                    <p>@diagnosis.MainCause</p>
                                </div>
                            </div>
                            <div class="diagnosis-grid">
                                <div><span>Affected item</span><strong>@diagnosis.AffectedItem</strong></div>
                                <div><span>Campaign</span><strong>@diagnosis.CampaignName</strong></div>
                                <div><span>Money impacted</span><strong>@diagnosis.MoneyImpacted</strong></div>
                                <div><span>Recommended fix</span><strong>@diagnosis.RecommendedFix</strong></div>
                                <div><span>Confidence</span><strong>@((diagnosis.Confidence * 100).ToString("F0"))%</strong></div>
                                <div><span>Data quality</span><strong>@diagnosis.DataQuality</strong></div>
                            </div>
                        </section>

                        <div class="technical-summary mb-3">
                            <div>
                                <div class="text-muted small">Selected recommendation</div>
                                <h2>@technicalDetails.Recommendation.Title</h2>
                                <p>@technicalDetails.Recommendation.Action</p>
                            </div>
                            <div class="technical-summary__meta">
                                <span>@GroupLabel(technicalDetails.Recommendation.RecommendationType)</span>
                                <span>@((technicalDetails.Recommendation.Confidence * 100).ToString("F0"))% confidence</span>
                                <span>@technicalDetails.Recommendation.SourceDateRangeStart.ToString("MMM d") - @technicalDetails.Recommendation.SourceDateRangeEnd.ToString("MMM d, yyyy")</span>
                            </div>
                        </div>

                        <section class="metric-help-grid mb-3">
                            @foreach (var metricHelp in MetricHelpers())
                            {
                                <div class="metric-help-card">
                                    <strong>@metricHelp.Name</strong>
                                    <span>@metricHelp.Explanation</span>
                                </div>
                            }
                        </section>

                        <div class="chart-grid mb-3">
                            @foreach (var chart in UsefulCharts(technicalDetails).Take(4))
                            {
                                <div class="chart-panel">
                                    <SimpleBarChart Title="@chart.Name"
                                                    Subtitle="@ChartSubtitle(chart.Name)"
                                                    Points="@chart.Points"
                                                    ValuePrefix="@ChartPrefix(chart.Name)"
                                                    ValueSuffix="@ChartSuffix(chart.Name)"
                                                    Unit="@ChartUnit(chart.Name)"
                                                    XAxisLabel="@ChartXAxis(chart.Name)"
                                                    YAxisLabel="@ChartYAxis(chart.Name)"
                                                    MaxLabel="@ChartMaxLabel(chart.Name)"
                                                    Horizontal="@IsHorizontalChart(chart.Name)" />
                                </div>
                            }
                        </div>

                        <div class="data-panel mb-3">
                            <div class="data-panel__header">Target Performance</div>
                            @if (!technicalDetails.KeywordPerformance.Any())
                            {
                                <p class="text-muted small px-3 pb-3 mb-0">No target or search-term rows are available for this recommendation.</p>
                            }
                            else
                            {
                                <div class="target-sort-bar">
                                    <span>Sort by</span>
                                    @foreach (var option in TargetSortOptions)
                                    {
                                        <button type="button"
                                                class="sort-chip @(targetSort == option.Value ? "is-active" : "")"
                                                @onclick="() => targetSort = option.Value">@option.Label</button>
                                    }
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-sm table-readable target-table mb-0">
                                        <thead>
                                            <tr>
                                                <th>Recommendation</th>
                                                <th>Target / search term</th>
                                                <th>Campaign</th>
                                                <th>Spend</th>
                                                <th>Sales</th>
                                                <th>Orders</th>
                                                <th>Clicks</th>
                                                <th>Impr.</th>
                                                <th title="How much ad spend it takes to make sales. Lower is better.">ACOS</th>
                                                <th title="How many dollars of sales you get for each $1 spent. Higher is better.">ROAS</th>
                                                <th title="Average cost per click.">CPC</th>
                                                <th title="How often shoppers click after seeing the ad.">CTR</th>
                                                <th title="How often clicks turn into orders.">CVR</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in SortedTargetRows(technicalDetails).Take(20))
                                            {
                                                <tr>
                                                    <td><span class="target-status @TargetStatusClass(row)">@TargetStatus(row)</span></td>
                                                    <td class="target-name">@row.KeywordOrSearchTerm</td>
                                                    <td>@row.CampaignName</td>
                                                    <td>@Money(row.Spend)</td>
                                                    <td>@Money(row.Sales)</td>
                                                    <td>@row.Purchases</td>
                                                    <td>@row.Clicks</td>
                                                    <td>@row.Impressions</td>
                                                    <td>@RateOrDash(row.ACOS, "P1", row.Sales > 0)</td>
                                                    <td>@NumberOrDash(row.ROAS, "0.##", row.Spend > 0)</td>
                                                    <td>@MoneyOrDash(Cpc(row), row.Clicks > 0)</td>
                                                    <td>@RateOrDash(row.CTR, "P1", row.Impressions > 0)</td>
                                                    <td>@RateOrDash(row.CVR, "P1", row.Clicks > 0)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>

                        <div class="data-panel mb-3">
                            <div class="data-panel__header">Why AI thinks this</div>
                            <div class="evidence-card-grid">
                                @foreach (var card in FriendlyEvidenceCards(technicalDetails).Take(8))
                                {
                                    <article class="evidence-card @EvidenceClass(card.Type)">
                                        <div class="evidence-card__type">@card.Type</div>
                                        <h3>@card.Title</h3>
                                        <p>@card.Explanation</p>
                                        <div class="evidence-card__meta">
                                            <span>@card.RelatedItem</span>
                                            <span>@card.DataSource</span>
                                            <span>@card.DateRange</span>
                                        </div>
                                    </article>
                                }
                            </div>
                            <details class="technical-raw">
                                <summary>Technical raw evidence</summary>
                                <div class="table-responsive">
                                    <table class="table table-sm table-readable mb-0">
                                        <thead>
                                            <tr>
                                                <th>Source</th>
                                                <th>Table</th>
                                                <th>Field</th>
                                                <th>Value</th>
                                                <th>Metric</th>
                                                <th>Notes</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in technicalDetails.Evidence)
                                            {
                                                <tr>
                                                    <td>@row.SourceType</td>
                                                    <td><code>@row.SourceTable</code></td>
                                                    <td><code>@row.SourceField</code></td>
                                                    <td>@row.SourceValue</td>
                                                    <td>@row.MetricName: @row.MetricValue.ToString("0.##")</td>
                                                    <td>@row.Notes</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </details>
                        </div>

                        <div class="data-panel mb-3">
                            <div class="data-panel__header">Time-of-day performance</div>
                            @{
                                var scorecardRows = technicalDetails.HourlyScorecard
                                    .OrderByDescending(r => r.EfficiencyScore)
                                    .Take(12)
                                    .ToList();
                                var hasData = scorecardRows.Any(r => r.Spend > 0 || r.Purchases > 0 || r.Sales > 0);
                            }
                            @if (!hasData)
                            {
                                <p class="text-muted small px-3 pb-3 mb-0">
                                    Hourly recommendations unavailable because AMC hourly purchase/spend data is not connected yet.
                                    Amazon Ads reporting can still support keyword, target, and campaign recommendations.
                                </p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-readable mb-0">
                                        <thead>
                                            <tr>
                                                <th>Day &amp; Time</th>
                                                <th>Spend</th>
                                                <th>Sales</th>
                                                <th>ROAS</th>
                                                <th>Purchases</th>
                                                <th>Efficiency</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in scorecardRows)
                                            {
                                                <tr>
                                                    <td class="fw-semibold">@row.DayOfWeek, @FormatHour(row.Hour)</td>
                                                    <td>$@row.Spend.ToString("F2")</td>
                                                    <td>$@row.Sales.ToString("F2")</td>
                                                    <td>@row.ROAS.ToString("0.##")×</td>
                                                    <td>@row.Purchases</td>
                                                    <td><span class="score-pill @ScoreClass(row.EfficiencyScore)">@ScoreLabel(row.EfficiencyScore)</span></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    }
            </div>
        }
    }
}
</div>

@if (showApplyReview)
{
    <div class="review-backdrop">
        <div class="review-modal" role="dialog" aria-modal="true" aria-label="Apply recommendation">
            <div class="review-modal__header">
                <div>
                    <h2>Apply Recommendation</h2>
                    <p>Review the current setup, edit the proposed change, then apply it to Amazon Ads only when you are ready.</p>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseApplyReview">Close</button>
            </div>

            @if (applyReviewLoading)
            {
                <div class="review-modal__body">
                    <div class="technical-loading">
                        <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                        <span>Loading live campaign setup...</span>
                    </div>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(applyReviewError))
            {
                <div class="review-modal__body">
                    <div class="alert alert-danger">@applyReviewError</div>
                </div>
            }
            else if (applyReview is not null)
            {
                <div class="review-modal__body">
                    <div class="review-status-row">
                        <span class="status-pill">@applyReview.Recommendation.Status</span>
                        <span>AI model: <strong>@EmptyDash(applyReview.AiModel)</strong></span>
                        <span>Data quality: <strong>@applyReview.DataQualityLabel</strong></span>
                    </div>

                    @foreach (var warning in applyReview.Warnings)
                    {
                        <div class="alert alert-warning small">@warning</div>
                    }

                    <div class="review-ads-shell">
                        <section class="review-ads-settings">
                            <div class="review-campaign-header">
                                <span class="review-toggle @(IsCampaignEnabled(applyReview.CurrentSetup.CampaignStatus) ? "is-on" : "")" aria-hidden="true"></span>
                                <div class="review-campaign-header__main">
                                    <h3>Campaign: @EmptyDash(applyReview.CurrentSetup.CampaignName)</h3>
                                    <div class="review-campaign-meta">
                                        <span>Status: <strong class="settings-pill settings-pill--warning">@ServingStatusLabel(applyReview.CurrentSetup)</strong></span>
                                        <span>Type: <strong class="settings-pill">Sponsored Products</strong></span>
                                        <span>Schedule: <strong class="settings-pill">@ScheduleLabel(applyReview.CurrentSetup)</strong></span>
                                        <span>Budget: <strong class="settings-pill">@BudgetLabel(applyReview.CurrentSetup)</strong></span>
                                    </div>
                                </div>
                            </div>

                            <div class="review-settings-table" role="table" aria-label="Current and proposed Amazon Ads settings">
                                <div class="review-settings-row review-settings-row--header" role="row">
                                    <div role="columnheader">Setting</div>
                                    <div role="columnheader">Current value</div>
                                    <div role="columnheader">Updated value</div>
                                </div>
                                @foreach (var row in BuildReviewSettingRows())
                                {
                                    <div class="review-settings-row @(row.IsChanged ? "is-changed" : "")" role="row">
                                        <div class="review-settings-label" role="cell">@row.Label</div>
                                        <div class="review-settings-value" role="cell">@row.CurrentValue</div>
                                        <div class="review-settings-value review-settings-value--updated" role="cell">
                                            @row.UpdatedValue
                                            @if (row.IsChanged)
                                            {
                                                <span class="settings-change-badge">Will change</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="review-edit-drawer">
                                <div class="review-edit-drawer__header">
                                    <div>
                                        <h3>Proposed change</h3>
                                        <p>@(editableChange.CanApplyAutomatically ? "Edit the update before applying it to Amazon Ads." : "This recommendation is review-only until Amazon returns the live object needed to apply it safely.")</p>
                                    </div>
                                    <span class="settings-pill settings-pill--accent">@editableChange.RiskLevel risk</span>
                                </div>

                                @if (!editableChange.CanApplyAutomatically)
                                {
                                    <div class="alert alert-warning">
                                        <strong>Cannot apply automatically yet.</strong>
                                        <div>@editableChange.ManualActionReason</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="review-form-grid">
                                        <label>
                                            <span>Action</span>
                                            <select class="form-select" @bind="editableChange.ActionType">
                                                <option value="PauseCampaign">Pause campaign</option>
                                                <option value="EnableCampaign">Enable campaign</option>
                                                <option value="UpdateCampaignBudget">Update campaign budget</option>
                                                <option value="UpdateTargetBid">Update target bid</option>
                                                <option value="UpdateKeywordBid">Update keyword bid</option>
                                                <option value="AddNegativeKeyword">Add negative keyword</option>
                                            </select>
                                        </label>
                                        <label>
                                            <span>Field</span>
                                            <input class="form-control" @bind="editableChange.FieldName" />
                                        </label>
                                        <label>
                                            <span>Current value</span>
                                            <input class="form-control" @bind="editableChange.CurrentValue" readonly />
                                        </label>
                                        <label>
                                            <span>Updated value</span>
                                            <input class="form-control" @bind="editableChange.ProposedValue" />
                                        </label>
                                    </div>
                                }

                                @if (editableChange.ActionType == "UpdateCampaignBudget")
                                {
                                    <div class="review-form-grid review-form-grid--compact">
                                        <label>
                                            <span>Final daily budget</span>
                                            <input type="number" step="0.01" min="1" class="form-control" @bind="editableChange.BudgetAmount" />
                                        </label>
                                    </div>
                                }
                                @if (editableChange.ActionType is "UpdateTargetBid" or "UpdateKeywordBid")
                                {
                                    <div class="review-form-grid review-form-grid--compact">
                                        <label>
                                            <span>Final bid</span>
                                            <input type="number" step="0.01" min="0.02" class="form-control" @bind="editableChange.FinalBid" />
                                        </label>
                                    </div>
                                }
                                @if (editableChange.ActionType == "AddNegativeKeyword")
                                {
                                    <div class="review-form-grid">
                                        <label>
                                            <span>Negative keyword text</span>
                                            <input class="form-control" @bind="editableChange.NegativeKeywordText" />
                                        </label>
                                        <label>
                                            <span>Match type</span>
                                            <select class="form-select" @bind="editableChange.NegativeKeywordMatchType">
                                                <option value="NEGATIVE_EXACT">Negative exact</option>
                                                <option value="NEGATIVE_PHRASE">Negative phrase</option>
                                            </select>
                                        </label>
                                    </div>
                                }

                                <label class="review-notes-field">
                                    <span>Approval notes</span>
                                    <textarea class="form-control" rows="2" @bind="applyNotes"></textarea>
                                </label>

                                <div class="review-impact">
                                    <strong>Why:</strong> @applyReview.Recommendation.Reason<br />
                                    <strong>Expected impact:</strong> @applyReview.Recommendation.ExpectedImpact<br />
                                    <strong>Confidence:</strong> @((applyReview.Recommendation.Confidence * 100).ToString("F0"))%
                                </div>
                            </div>
                        </section>
                    </div>

                    <div class="review-ai-tools">
                        <button class="btn btn-outline-primary" @onclick="AskBeginnerChinese" disabled="@aiThinking">我是傻瓜</button>
                        <button class="btn btn-outline-dark" @onclick="OpenAiChat" disabled="@aiThinking">Ask AI about this recommendation</button>
                    </div>

                    @if (showAiPanel)
                    {
                        <section class="review-panel mt-3">
                            <h3>@(beginnerChineseMode ? "傻瓜模式解释" : "Ask AI about this recommendation")</h3>
                            <div class="ai-chat-thread" aria-live="polite">
                                @if (!aiMessages.Any())
                                {
                                    <div class="ai-chat-empty">
                                        Ask a question about this exact recommendation. The AI will use the product, campaign, current setup, proposed change, and evidence shown here.
                                    </div>
                                }
                                @foreach (var message in aiMessages)
                                {
                                    <div class="ai-chat-message ai-chat-message--@message.Role">
                                        <div class="ai-chat-message__role">@(message.Role == "user" ? "You" : "AI")</div>
                                        <div class="ai-chat-message__content">@message.Content</div>
                                    </div>
                                }
                            </div>
                            <div class="input-group mb-2">
                                <input class="form-control"
                                       @bind="aiQuestion"
                                       placeholder="@(beginnerChineseMode ? "继续用中文问，比如：我应该直接点 Apply 吗？" : "Ask: Is this risky? What happens if I do nothing?")"
                                       @onkeydown="HandleAiInputKeyDown" />
                                <button class="btn btn-primary" @onclick="AskAiQuestion" disabled="@aiThinking">Send</button>
                            </div>
                            @if (aiThinking)
                            {
                                <div class="text-muted small">Asking AI with this recommendation's context...</div>
                            }
                            <button class="btn btn-sm btn-outline-secondary" @onclick="CopyAiAnswer" disabled="@(!aiMessages.Any(m => m.Role == "assistant"))">Copy latest answer</button>
                            @if (!string.IsNullOrWhiteSpace(aiError))
                            {
                                <div class="alert alert-danger small">@aiError</div>
                            }
                        </section>
                    }
                </div>

                <div class="review-modal__footer">
                    @if (editableChange.IsDestructive || editableChange.ActionType is "PauseCampaign" or "AddNegativeKeyword")
                    {
                        <label class="form-check me-auto">
                            <input class="form-check-input" type="checkbox" @bind="confirmDestructive" />
                            <span class="form-check-label">I understand this can reduce or stop ad delivery.</span>
                        </label>
                    }
                    else
                    {
                        <span class="me-auto text-muted small">@(editableChange.CanApplyAutomatically ? "Nothing changes in Amazon Ads until you click Apply Changes." : "This recommendation is review-only because it cannot be safely applied automatically yet.")</span>
                    }
                    <button class="btn btn-outline-secondary" @onclick="CloseApplyReview">Cancel</button>
                    <button class="btn btn-success" @onclick="ApplyChanges" disabled="@(!CanApplyCurrentChange)">
                        @(applyingChanges ? "Applying..." : editableChange.CanApplyAutomatically ? "Apply Changes" : "Cannot Apply Automatically")
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(applyResultMessage))
                {
                    <div class="alert @(applySucceeded ? "alert-success" : "alert-danger") m-3">@applyResultMessage</div>
                }
            }
        </div>
    </div>
}

@code {
    private List<ProductProfile> products = new();
    private ProductProfile? selectedProduct;
    private string selectedProductId = "";
    private List<AiRecommendationDto> recommendations = new();
    private TechnicalRecommendationDetailsDto? technicalDetails;
    private AiRecommendationDto? selectedRecommendation;
    private bool loading;
    private bool analyzing;
    private bool technicalLoading;
    private string? error;
    private string? amcAutoQueryNotice;
    private string? technicalError;
    private List<string> analysisWarnings = new();
    private Dictionary<string, string> amcWorkflowSqlByType = new();
    private AmcStatusDto? amcStatus;
    private AiRuntimeStatusDto? aiStatus;
    private string activeTab = "simple";
    private string? editingId;
    private string editText = "";
    private Dictionary<string, string?> _imageUrls = new();
    private string dateRangeMode = "week";
    private DateOnly dateRangeEnd = DateOnly.FromDateTime(DateTime.Today.AddDays(-1));
    private DateOnly dateRangeStart = DateOnly.FromDateTime(DateTime.Today.AddDays(-7));
    private string targetSort = "wasted";
    private bool showApplyReview;
    private bool applyReviewLoading;
    private bool applyingChanges;
    private string? applyReviewError;
    private RecommendationReviewDto? applyReview;
    private RecommendationProposedChangeDto editableChange = new();
    private string applyNotes = "";
    private bool confirmDestructive;
    private string? applyResultMessage;
    private bool applySucceeded;
    private bool showAiPanel;
    private bool beginnerChineseMode;
    private bool aiThinking;
    private string aiQuestion = "";
    private List<RecommendationChatMessageDto> aiMessages = new();
    private string? aiError;

    private static readonly IReadOnlyList<SortOption> TargetSortOptions =
    [
        new("wasted", "Wasted spend"),
        new("roas", "Best ROAS"),
        new("spend", "Highest spend"),
        new("acos", "Worst ACOS"),
        new("sales", "Sales"),
        new("clicks", "Clicks"),
        new("orders", "Orders")
    ];

    private sealed record ReviewSettingRow(string Label, string CurrentValue, string UpdatedValue, bool IsChanged);

    private IEnumerable<ProductProfile> FilteredProducts => products.Where(p =>
        (!Prefs.HideOutOfStock || p.StockQuantity is null || p.StockQuantity > 0) &&
        (!Prefs.ShowActiveOnly || p.IsActive));

    private IEnumerable<AiRecommendationDto> OrderedRecommendations => recommendations
        .OrderByDescending(r => PriorityWeight(PriorityLabel(r)))
        .ThenByDescending(r => r.Confidence)
        .ThenBy(r => GroupLabel(r.RecommendationType))
        .ThenBy(r => r.Title);

    private bool CanApplyCurrentChange =>
        !applyingChanges &&
        editableChange.CanApplyAutomatically &&
        (editableChange.ActionType is not ("PauseCampaign" or "AddNegativeKeyword") || confirmDestructive);

    private IEnumerable<string> VisibleAnalysisWarnings => amcStatus is { IsAuthorized: false }
        ? analysisWarnings.Where(w => !w.Contains("No AMC conversion-hour data found", StringComparison.OrdinalIgnoreCase))
        : analysisWarnings;

    protected override async Task OnInitializedAsync()
    {
        AccountState.OnChange += OnAccountChanged;
        Prefs.OnChange += OnPreferencesChanged;
        await Prefs.LoadAsync();
        await LoadProducts();
    }

    private async void OnAccountChanged()
    {
        await LoadProducts();
        StateHasChanged();
    }

    private async void OnPreferencesChanged()
    {
        await LoadProducts();
        StateHasChanged();
    }

    private async Task LoadProducts()
    {
        if (AccountState.SelectedAccount is null) return;
        loading = true;
        error = null;
        amcAutoQueryNotice = null;
        analysisWarnings.Clear();
        amcWorkflowSqlByType = new();
        amcStatus = null;
        aiStatus = null;
        selectedProduct = null;
        selectedProductId = "";
        recommendations.Clear();
        technicalDetails = null;
        technicalError = null;
        try
        {
            products = await Api.GetProductsWithCampaignsAsync(
                AccountState.SelectedAccount.AccountKey,
                Prefs.ShowAiProductsWithActiveCampaignsOnly);
            aiStatus = await Api.GetAiRuntimeStatusAsync();
            amcStatus = await Api.GetAmcStatusAsync(AccountState.SelectedAccount.AccountKey);
            _ = LoadImagesAsync(products.Select(p => p.ASIN).Distinct().ToList());
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        loading = false;
    }

    private async Task SelectProduct(ProductProfile product)
    {
        selectedProductId = product.Id;
        selectedProduct = product;
        recommendations.Clear();
        technicalDetails = null;
        selectedRecommendation = null;
        error = null;
        amcAutoQueryNotice = null;
        analysisWarnings.Clear();
        amcWorkflowSqlByType = new();
        technicalError = null;
        if (amcStatus is null && AccountState.SelectedAccount is not null)
            amcStatus = await Api.GetAmcStatusAsync(AccountState.SelectedAccount.AccountKey);
        if (selectedProduct is not null && AccountState.SelectedAccount is not null)
            recommendations = await Api.GetRecommendationsV2Async(AccountState.SelectedAccount.AccountKey, selectedProduct.Id);
    }

    private async Task LoadImagesAsync(List<string> asins)
    {
        foreach (var asin in asins)
        {
            if (string.IsNullOrEmpty(asin) || _imageUrls.ContainsKey(asin)) continue;
            _imageUrls[asin] = null;
            var url = await Api.GetProductImageUrlAsync(asin);
            _imageUrls[asin] = url;
            StateHasChanged();
        }
    }

    private async Task SetActiveCampaignProductFilter(bool value)
    {
        await Prefs.SetShowAiProductsWithActiveCampaignsOnlyAsync(value);
    }

    private async Task Analyze()
    {
        if (selectedProduct is null || AccountState.SelectedAccount is null) return;
        if (EffectiveDateRangeStart > EffectiveDateRangeEnd)
        {
            error = "Date range start must be before the end date.";
            return;
        }

        analyzing = true;
        error = null;
        amcAutoQueryNotice = null;
        analysisWarnings.Clear();
        amcWorkflowSqlByType = new();
        recommendations.Clear();
        selectedRecommendation = null;
        technicalDetails = null;
        technicalError = null;
        try
        {
            var ensureAmcData = await ShouldQueryMissingAmcData();
            if (ensureAmcData is null)
            {
                analyzing = false;
                return;
            }
            if (ensureAmcData.Value)
            {
                amcAutoQueryNotice =
                    $"AMC hourly data is missing for {EffectiveDateRangeStart:MMM d} - {EffectiveDateRangeEnd:MMM d, yyyy}. Querying AMC before AI review; this can take several minutes.";
                StateHasChanged();
            }

            var result = await Api.AnalyzeProductV2Async(
                AccountState.SelectedAccount.AccountKey,
                selectedProduct.Id,
                EffectiveDateRangeStart,
                EffectiveDateRangeEnd,
                ensureAmcData.Value);
            if (result is null || !result.Success)
            {
                error = result?.ErrorMessage ?? result?.Error ?? "AI analysis failed. No AI recommendations were generated.";
                analysisWarnings = result?.Warnings ?? new();
                amcWorkflowSqlByType = result?.AmcWorkflowSqlByType ?? new();
            }
            else
            {
                recommendations = result.V2Recommendations;
                analysisWarnings = result.Warnings;
                amcWorkflowSqlByType = result.AmcWorkflowSqlByType ?? new();
            }

            if (recommendations.Any())
                selectedRecommendation = OrderedRecommendations.First();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        analyzing = false;
    }

    private async Task<bool?> ShouldQueryMissingAmcData()
    {
        if (selectedProduct is null || AccountState.SelectedAccount is null) return false;

        try
        {
            var status = await Api.GetAmcHourlyDataStatusAsync(
                AccountState.SelectedAccount.AccountKey,
                selectedProduct.Id,
                EffectiveDateRangeStart,
                EffectiveDateRangeEnd);
            if (status is not { IsMissing: true }) return false;

            amcStatus ??= await Api.GetAmcStatusAsync(AccountState.SelectedAccount.AccountKey);
            if (amcStatus is not { IsAuthorized: true })
            {
                analysisWarnings.Add("AMC hourly data is missing for this date range, and AMC is not authorized. AI review will use available Amazon Ads reporting data only.");
                return false;
            }

            var confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                $"AMC hourly data is missing for {EffectiveDateRangeStart:MMM d} - {EffectiveDateRangeEnd:MMM d, yyyy}. AI review can query AMC now and import the matching hourly data first, but loading may take several minutes. Continue?");
            if (confirmed) return true;

            amcAutoQueryNotice = "AI review was canceled so AMC data can be queried before analysis.";
            return null;
        }
        catch (Exception ex)
        {
            analysisWarnings.Add($"AMC hourly data status could not be checked: {ex.Message}");
            return false;
        }
    }

    private DateOnly EffectiveDateRangeEnd => dateRangeEnd;

    private DateOnly EffectiveDateRangeStart => dateRangeMode switch
    {
        "day" => dateRangeEnd,
        "week" => dateRangeEnd.AddDays(-6),
        _ => dateRangeStart
    };

    private string dateRangeStartText => dateRangeStart.ToString("yyyy-MM-dd");
    private string dateRangeEndText => dateRangeEnd.ToString("yyyy-MM-dd");

    private void SetDateRangeMode(string mode)
    {
        dateRangeMode = mode;
        if (mode == "day")
            dateRangeStart = dateRangeEnd;
        else if (mode == "week")
            dateRangeStart = dateRangeEnd.AddDays(-6);
    }

    private void OnStartDateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var parsed))
            dateRangeStart = parsed;
    }

    private void OnEndDateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var parsed))
        {
            dateRangeEnd = parsed;
            if (dateRangeMode == "day")
                dateRangeStart = parsed;
            else if (dateRangeMode == "week")
                dateRangeStart = parsed.AddDays(-6);
        }
    }

    private async Task OpenTechnicalTab()
    {
        activeTab = "technical";
        if (technicalDetails is null && selectedRecommendation is null && recommendations.Any())
            selectedRecommendation = OrderedRecommendations.First();
        if (technicalDetails is null && selectedRecommendation is not null && string.IsNullOrWhiteSpace(technicalError))
            await LoadTechnicalDetails(selectedRecommendation);
    }

    private async Task LoadTechnicalDetails(AiRecommendationDto rec)
    {
        if (selectedProduct is null || AccountState.SelectedAccount is null) return;
        selectedRecommendation = rec;
        technicalLoading = true;
        technicalError = null;
        activeTab = "technical";
        try
        {
            technicalDetails = await Api.GetRecommendationTechnicalDetailsAsync(
                AccountState.SelectedAccount.AccountKey, selectedProduct.Id, rec.RecommendationId);
        }
        catch (Exception ex)
        {
            technicalDetails = null;
            technicalError = ex.Message;
        }
        finally
        {
            technicalLoading = false;
        }
    }

    private async Task SelectTechnical(AiRecommendationDto rec) => await LoadTechnicalDetails(rec);

    private async Task Approve(AiRecommendationDto rec)
    {
        await OpenApplyReview(rec, openChinese: false);
    }

    private async Task ExplainChinese(AiRecommendationDto rec)
    {
        await OpenApplyReview(rec, openChinese: true);
    }

    private async Task OpenApplyReview(AiRecommendationDto rec, bool openChinese)
    {
        if (selectedProduct is null || AccountState.SelectedAccount is null) return;
        selectedRecommendation = rec;
        showApplyReview = true;
        applyReviewLoading = true;
        applyReviewError = null;
        applyResultMessage = null;
        applySucceeded = false;
        showAiPanel = false;
        aiMessages.Clear();
        aiError = null;
        aiQuestion = "";
        confirmDestructive = false;
        StateHasChanged();

        try
        {
            applyReview = await Api.GetRecommendationApplyReviewAsync(
                AccountState.SelectedAccount.AccountKey,
                selectedProduct.Id,
                rec.RecommendationId);
            editableChange = CloneChange(applyReview?.ProposedChange ?? new());
            applyNotes = "";
            rec.Status = applyReview?.Recommendation.Status ?? "Review";
            if (openChinese)
                await AskBeginnerChinese();
        }
        catch (Exception ex)
        {
            applyReviewError = ex.Message;
        }
        finally
        {
            applyReviewLoading = false;
        }
    }

    private void CloseApplyReview()
    {
        showApplyReview = false;
        applyReview = null;
        applyReviewError = null;
        applyResultMessage = null;
        showAiPanel = false;
        aiMessages.Clear();
        aiQuestion = "";
        aiError = null;
    }

    private async Task ApplyChanges()
    {
        if (applyReview is null || selectedProduct is null || AccountState.SelectedAccount is null) return;
        applyingChanges = true;
        applyResultMessage = null;
        applySucceeded = false;
        try
        {
            var result = await Api.ApplyRecommendationChangesAsync(applyReview.Recommendation.RecommendationId, new ApplyRecommendationRequest
            {
                AccountKey = AccountState.SelectedAccount.AccountKey,
                ProductId = selectedProduct.Id,
                ProposedChange = editableChange,
                UserNotes = applyNotes,
                ConfirmDestructive = confirmDestructive
            });
            applySucceeded = result?.Success == true;
            applyResultMessage = result?.Message ?? result?.Error ?? "Apply finished without a response.";
            var rec = recommendations.FirstOrDefault(r => r.RecommendationId == applyReview.Recommendation.RecommendationId);
            if (rec is not null)
                rec.Status = applySucceeded ? "Applied" : "ApplyFailed";
            if (applyReview is not null)
                applyReview.Recommendation.Status = applySucceeded ? "Applied" : "ApplyFailed";
        }
        catch (Exception ex)
        {
            applySucceeded = false;
            applyResultMessage = ex.Message;
        }
        finally
        {
            applyingChanges = false;
        }
    }

    private async Task AskBeginnerChinese()
    {
        beginnerChineseMode = true;
        showAiPanel = true;
        if (!aiMessages.Any(m => m.Role == "assistant") && string.IsNullOrWhiteSpace(aiQuestion))
            aiQuestion = "我是傻瓜，给我讲明白。";
        await AskAiQuestion();
    }

    private void OpenAiChat()
    {
        beginnerChineseMode = false;
        showAiPanel = true;
        aiQuestion = "";
        aiError = null;
    }

    private async Task AskAiQuestion()
    {
        if (applyReview is null || selectedProduct is null || AccountState.SelectedAccount is null) return;
        var question = string.IsNullOrWhiteSpace(aiQuestion)
            ? (beginnerChineseMode ? "我是傻瓜，给我讲明白。" : "Why are you recommending this?")
            : aiQuestion.Trim();
        aiThinking = true;
        aiError = null;
        try
        {
            var history = aiMessages.ToList();
            aiMessages.Add(new RecommendationChatMessageDto { Role = "user", Content = question });
            aiQuestion = "";
            var response = await Api.AskRecommendationAiAsync(applyReview.Recommendation.RecommendationId, new RecommendationAiQuestionRequest
            {
                AccountKey = AccountState.SelectedAccount.AccountKey,
                ProductId = selectedProduct.Id,
                Question = question,
                BeginnerChineseMode = beginnerChineseMode,
                ProposedChange = editableChange,
                History = history
            });
            if (response?.Success == true)
                aiMessages.Add(new RecommendationChatMessageDto { Role = "assistant", Content = response.Answer });
            else
            {
                aiError = response?.Error ?? "AI request failed.";
                RemoveLatestUserQuestion(question);
            }
        }
        catch (Exception ex)
        {
            aiError = ex.Message;
            RemoveLatestUserQuestion(question);
        }
        finally
        {
            aiThinking = false;
        }
    }

    private async Task HandleAiInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !aiThinking)
            await AskAiQuestion();
    }

    private void RemoveLatestUserQuestion(string question)
    {
        if (aiMessages.Count > 0 &&
            aiMessages[^1].Role == "user" &&
            string.Equals(aiMessages[^1].Content, question, StringComparison.Ordinal))
        {
            aiMessages.RemoveAt(aiMessages.Count - 1);
        }
    }

    private async Task CopyAiAnswer()
    {
        var latest = aiMessages.LastOrDefault(m => m.Role == "assistant")?.Content;
        if (!string.IsNullOrWhiteSpace(latest))
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", latest);
    }

