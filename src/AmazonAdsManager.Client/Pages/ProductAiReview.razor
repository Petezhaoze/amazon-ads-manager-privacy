    private static string ScheduleLabel(RecommendationSetupDto setup)
    {
        var start = FormatAmazonDate(setup.StartDate);
        var end = FormatAmazonDate(setup.EndDate);
        if (start == "-" && end == "-") return "Schedule not available";
        return $"{(start == "-" ? "Start date not available" : start)} - {(end == "-" ? "No end date" : end)}";
    }

    private static string FormatAmazonDate(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "-";
        if (DateOnly.TryParseExact(raw, "yyyyMMdd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var compact))
            return compact.ToString("MMM d, yyyy");
        if (DateOnly.TryParse(raw, out var parsed))
            return parsed.ToString("MMM d, yyyy");
        return raw;
    }

