    private List<ReviewSettingRow> BuildReviewSettingRows()
    {
        if (applyReview is null) return new();
        var setup = applyReview.CurrentSetup;
        var rows = new List<ReviewSettingRow>
        {
            Row("Campaign name", EmptyDash(setup.CampaignName), EmptyDash(setup.CampaignName)),
            Row("Campaign ID", EmptyDash(setup.CampaignId), EmptyDash(setup.CampaignId)),
            Row("Type", "Sponsored Products", "Sponsored Products"),
            Row("Active / Paused", CampaignStateLabel(setup.CampaignStatus), UpdatedCampaignStateLabel(setup.CampaignStatus)),
            Row("Status", ServingStatusLabel(setup), ServingStatusLabel(setup)),
            Row("Schedule", ScheduleLabel(setup), ScheduleLabel(setup)),
            Row("Budget", BudgetLabel(setup), UpdatedBudgetLabel(setup)),
            Row("Campaign targeting", CampaignTargetingLabel(setup), CampaignTargetingLabel(setup)),
            Row("Campaign bidding strategy", EmptyDash(setup.BiddingStrategy) == "-" ? "Dynamic bids - up and down" : EmptyDash(setup.BiddingStrategy), EmptyDash(setup.BiddingStrategy) == "-" ? "Dynamic bids - up and down" : EmptyDash(setup.BiddingStrategy)),
            Row("Ad group", SettingWithId(setup.AdGroupName, setup.AdGroupId), SettingWithId(setup.AdGroupName, setup.AdGroupId)),
            Row("Amazon object ID", LiveObjectIdLabel(setup), LiveObjectIdLabel(setup)),
            Row("Target / search term / ASIN", EmptyDash(setup.TargetOrSearchTerm), UpdatedTargetLabel(setup)),
            Row("Match / targeting type", EmptyDash(setup.MatchType ?? setup.TargetingType), UpdatedMatchTypeLabel(setup)),
            Row("Bid", MoneyOrDash(setup.CurrentBid), UpdatedBidLabel(setup)),
            Row("Negative targeting", EmptyDash(setup.NegativeKeywords) == "-" ? "No negative keyword shown" : EmptyDash(setup.NegativeKeywords), UpdatedNegativeTargetingLabel(setup)),
            Row("Recent performance", PerformanceLabel(applyReview.Performance), PerformanceLabel(applyReview.Performance))
        };

        if (!rows.Any(r => r.IsChanged) && !string.IsNullOrWhiteSpace(editableChange.FieldName))
            rows.Insert(0, Row(editableChange.FieldName, EmptyDash(editableChange.CurrentValue), EmptyDash(editableChange.ProposedValue)));

        return rows;
    }

