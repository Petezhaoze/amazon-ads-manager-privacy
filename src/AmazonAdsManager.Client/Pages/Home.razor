@page "/"
@inject AccountState AccountState
@inject AdsApiClient Api
@implements IDisposable

<PageTitle>Dashboard – Amazon Ads Manager</PageTitle>

<h1>Dashboard</h1>

@if (AccountState.SelectedAccount is null)
{
    <p class="text-muted">Select an account from the sidebar to get started.</p>
}
else
{
    <p class="lead">Logged in as <strong>@AccountState.SelectedAccount.DisplayName</strong></p>

    <div class="row g-3 mt-2">
        <div class="col-md-4">
            <div class="card text-bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Campaigns</h5>
                    <p class="card-text fs-3">@campaignCount</p>
                    <a href="campaigns" class="btn btn-sm btn-light">View</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-bg-success">
                <div class="card-body">
                    <h5 class="card-title">Active Schedules</h5>
                    <p class="card-text fs-3">@scheduleCount</p>
                    <a href="schedules" class="btn btn-sm btn-light">Manage</a>
                </div>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <p class="mt-3 text-muted">Loading...</p>
    }
}

@code {
    private int campaignCount;
    private int scheduleCount;
    private bool loading;

    protected override async Task OnInitializedAsync()
    {
        AccountState.OnChange += OnAccountChanged;
        await LoadData();
    }

    private async void OnAccountChanged()
    {
        await LoadData();
        StateHasChanged();
    }

    private async Task LoadData()
    {
        if (AccountState.SelectedAccount is null) return;
        loading = true;
        var key = AccountState.SelectedAccount.AccountKey;
        var schedules = await Api.GetSchedulesAsync(key);
        scheduleCount = schedules.Count;
        loading = false;
        campaignCount = 0; // avoids calling Amazon API on every dashboard load
    }

    public void Dispose() => AccountState.OnChange -= OnAccountChanged;
}
